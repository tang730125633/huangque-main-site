+  function templateMediaUrl(value) {
+    var url = value || "";
+    var origin = "https://huangquechuanmei.com";
+    if (url.indexOf(origin + "/workbench/ip12/api/") === 0) {
+      url = url.replace(origin + "/workbench/ip12", "");
+    } else if (url.indexOf("/workbench/ip12/api/") === 0) {
+      url = url.replace("/workbench/ip12", "");
+    } else if (url.indexOf(origin + "/api/") === 0) {
+      url = url.replace(origin, "");
+    }
+    return url.indexOf("/api/") === 0 ? relUrl(url) : url;
+  }
+
+  function templateItemMedia(it) {
+    return { image: templateMediaUrl(it.image_url), preview: templateMediaUrl(it.preview_url) };
+  }
+
+  // 模板目录是浏览型组件：横向挑封面，详情与操作集中在下方；不把 22 组按钮重复铺满页面。
+  function renderTemplateCatalogWidget(w, box) {
+    var items = (w.items || []).filter(function (it) { return it && (it.id || it.title); });
+    if (!items.length) return null;
+    box.classList.add("template-catalog-box", "nonfilm-panel");
+
+    var catalog = document.createElement("div");
+    catalog.className = "template-catalog";
+
+    var toolbar = document.createElement("div");
+    toolbar.className = "template-catalog-toolbar";
+    var position = document.createElement("span");
+    position.className = "template-catalog-position";
+    toolbar.appendChild(position);
+    var nav = document.createElement("div");
+    nav.className = "template-catalog-nav";
+    var previous = document.createElement("button");
+    previous.type = "button";
+    previous.className = "template-catalog-arrow";
+    previous.setAttribute("aria-label", "上一个模板");
+    previous.innerHTML = "&#8592;";
+    var next = document.createElement("button");
+    next.type = "button";
+    next.className = "template-catalog-arrow";
+    next.setAttribute("aria-label", "下一个模板");
+    next.innerHTML = "&#8594;";
+    nav.appendChild(previous);
+    nav.appendChild(next);
+    toolbar.appendChild(nav);
+    catalog.appendChild(toolbar);
+
+    var rail = document.createElement("div");
+    rail.className = "template-card-rail";
+    rail.tabIndex = 0;
+    rail.setAttribute("role", "group");
+    rail.setAttribute("aria-label", "模板列表");
+    catalog.appendChild(rail);
+
+    var detail = document.createElement("div");
+    detail.className = "template-detail";
+    catalog.appendChild(detail);
+
+    var cards = [];
+    var activeIndex = 0;
+    if (pickedChoices.script) {
+      items.some(function (it, index) {
+        if (String(it.id || "") !== String(pickedChoices.script.id || "")) return false;
+        activeIndex = index;
+        return true;
+      });
+    }
+
+    function pauseDetailMedia() {
+      Array.prototype.forEach.call(detail.querySelectorAll("video, audio"), function (media) {
+        if (typeof media.pause === "function") media.pause();
+      });
+    }
+
+    function renderDetail() {
+      var it = items[activeIndex];
+      var media = templateItemMedia(it);
+      position.textContent = (activeIndex + 1) + " / " + items.length;
+      previous.disabled = activeIndex === 0;
+      next.disabled = activeIndex === items.length - 1;
+      cards.forEach(function (card, index) {
+        var active = index === activeIndex;
+        card.classList.toggle("active", active);
+        if (active) card.setAttribute("aria-current", "true");
+        else card.removeAttribute("aria-current");
+        card.tabIndex = active ? 0 : -1;
+      });
+
+      pauseDetailMedia();
+      detail.innerHTML = "";
+      var visual = document.createElement("div");
+      visual.className = "template-detail-media";
+      var video = null;
+      if (media.preview) {
+        video = document.createElement("video");
+        video.controls = true;
+        video.preload = "none";
+        video.playsInline = true;
+        video.src = media.preview;
+        if (media.image) video.poster = media.image;
+        visual.appendChild(video);
+      } else if (media.image) {
+        var largeImage = document.createElement("img");
+        largeImage.src = media.image;
+        largeImage.alt = it.title || "模板预览";
+        largeImage.loading = "lazy";
+        visual.appendChild(largeImage);
+      } else {
+        var empty = document.createElement("div");
+        empty.className = "template-detail-media-empty";
+        empty.textContent = "暂无预览";
+        visual.appendChild(empty);
+      }
+      detail.appendChild(visual);
+
+      var copy = document.createElement("div");
+      copy.className = "template-detail-copy";
+      var title = document.createElement("div");
+      title.className = "template-detail-title";
+      title.textContent = it.title || it.name || String(it.id || "模板");
+      copy.appendChild(title);
+      if (it.summary) {
+        var meta = document.createElement("div");
+        meta.className = "template-detail-meta";
+        meta.textContent = it.summary;
+        copy.appendChild(meta);
+      }
+      var description = document.createElement("div");
+      description.className = "template-detail-description";
+      description.textContent = it.body || "点击播放小样查看模板效果，确认后即可使用。";
+      copy.appendChild(description);
+
+      var actions = document.createElement("div");
+      actions.className = "template-detail-actions";
+      if (video) {
+        var preview = document.createElement("button");
+        preview.type = "button";
+        preview.className = "template-detail-preview";
+        function showPlay() { preview.innerHTML = svgIcon("play") + " 播放小样"; }
+        function showPause() { preview.innerHTML = svgIcon("pause") + " 暂停预览"; }
+        showPlay();
+        preview.addEventListener("click", function () {
+          if (video.paused) {
+            var playResult = video.play();
+            if (playResult && playResult.then) playResult.then(showPause).catch(showPlay);
+            else showPause();
+          } else {
+            video.pause();
+            showPlay();
+          }
+        });
+        video.addEventListener("pause", showPlay);
+        video.addEventListener("ended", showPlay);
+        actions.appendChild(preview);
+      }
+      if (it.body) {
+        var full = document.createElement("button");
+        full.type = "button";
+        full.className = "template-detail-full";
+        full.textContent = "查看完整说明";
+        full.addEventListener("click", function () {
+          description.classList.toggle("expanded");
+          full.textContent = description.classList.contains("expanded") ? "收起说明" : "查看完整说明";
+        });
+        actions.appendChild(full);
+      }
+      var use = document.createElement("button");
+      use.type = "button";
+      use.className = "pick template-detail-use";
+      use.textContent = "使用此模板";
+      use.addEventListener("click", function () {
+        pauseDetailMedia();
+        pickWidget(w, it, cards[activeIndex]);
+        updateBackBottom();
+      });
+      actions.appendChild(use);
+      copy.appendChild(actions);
+      detail.appendChild(copy);
+    }
+
+    function select(index, scrollCard) {
+      activeIndex = Math.max(0, Math.min(items.length - 1, index));
+      renderDetail();
+      if (scrollCard && cards[activeIndex] && cards[activeIndex].scrollIntoView) {
+        cards[activeIndex].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
+      }
+    }
+
+    items.forEach(function (it, index) {
+      var media = templateItemMedia(it);
+      var card = document.createElement("button");
+      card.type = "button";
+      card.className = "template-card";
+      card.dataset.itemId = String(it.id || "");
+      card.dataset.baseAriaLabel = "查看模板：" + (it.title || it.name || it.id || "");
+      card.setAttribute("aria-label", card.dataset.baseAriaLabel);
+      if (media.image) {
+        var image = document.createElement("img");
+        image.className = "template-card-image";
+        image.src = media.image;
+        image.alt = "";
+        image.loading = "lazy";
+        card.appendChild(image);
+      } else {
+        var placeholder = document.createElement("span");
+        placeholder.className = "template-card-image template-card-placeholder";
+        placeholder.textContent = "模板预览";
+        card.appendChild(placeholder);
+      }
+      var name = document.createElement("span");
+      name.className = "template-card-name";
+      name.textContent = it.title || it.name || String(it.id || "模板");
+      card.appendChild(name);
+      if (it.summary) {
+        var sub = document.createElement("span");
+        sub.className = "template-card-meta";
+        sub.textContent = it.summary;
+        card.appendChild(sub);
+      }
+      var check = document.createElement("span");
+      check.className = "template-card-check";
+      check.innerHTML = svgIcon("check");
+      card.appendChild(check);
+      card.addEventListener("click", function () { select(index, false); });
+      rail.appendChild(card);
+      cards.push(card);
+      if (pickedChoices.script && String(pickedChoices.script.id || "") === String(it.id || "")) {
+        card.dataset.kind = "script";
+        card.classList.add("picked");
+        card.setAttribute("aria-label", card.dataset.baseAriaLabel + "，已选择");
+      }
+    });
+
+    previous.addEventListener("click", function () { select(activeIndex - 1, true); });
+    next.addEventListener("click", function () { select(activeIndex + 1, true); });
+    rail.addEventListener("keydown", function (event) {
+      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
+      event.preventDefault();
+      select(activeIndex + (event.key === "ArrowRight" ? 1 : -1), true);
+      cards[activeIndex].focus();
+    });
+    rail.addEventListener("wheel", function (event) {
+      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX) || rail.scrollWidth <= rail.clientWidth) return;
+      var maxScroll = rail.scrollWidth - rail.clientWidth;
+      var canMove = event.deltaY < 0 ? rail.scrollLeft > 1 : rail.scrollLeft < maxScroll - 1;
+      if (!canMove) return;
+      event.preventDefault();
+      rail.scrollLeft += event.deltaY;
+    }, { passive: false });
+
+    renderDetail();
+    return catalog;
+  }
