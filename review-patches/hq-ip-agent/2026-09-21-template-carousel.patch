diff --git a/static/style.css b/static/style.css
index 0617918..e3b80a7 100644
--- a/static/style.css
+++ b/static/style.css
@@ -717,6 +717,74 @@ button { font-family: inherit; }
 .widget-card .wc-act button:hover { border-color: var(--brand-600); }
 .widget-card .wc-act button.pick { border-color: var(--brand-600); color: var(--brand-700, var(--brand-600)); }
 .widget-list { display: flex; flex-direction: column; gap: 8px; }
+
+/* 模板目录：横向封面浏览 + 单一详情操作区，避免 22 张纵向大卡重复按钮。 */
+.template-catalog-box { padding: 15px 16px 16px; overflow: hidden; }
+.template-catalog-box .widget-title { font-size: 16px; font-weight: 750; }
+.template-catalog-box .widget-hint { margin: 4px 0 8px; }
+.template-catalog { min-width: 0; }
+.template-catalog-toolbar { display: flex; align-items: center; justify-content: space-between;
+  gap: 10px; margin-bottom: 8px; }
+.template-catalog-position { color: var(--fg-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
+.template-catalog-nav { display: flex; gap: 6px; }
+.template-catalog-arrow { width: 32px; height: 32px; display: inline-flex; align-items: center;
+  justify-content: center; border: 1px solid var(--border); border-radius: 9px;
+  background: var(--surface); color: var(--fg); cursor: pointer; font-size: 17px; }
+.template-catalog-arrow:hover:not(:disabled) { border-color: var(--brand-600); color: var(--brand-600); }
+.template-catalog-arrow:disabled { opacity: .35; cursor: default; }
+.template-card-rail { display: grid; grid-auto-flow: column;
+  grid-auto-columns: minmax(176px, calc((100% - 36px) / 4)); gap: 12px;
+  overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory;
+  scrollbar-width: thin; scrollbar-color: var(--control-border) transparent;
+  padding: 3px 3px 10px; margin: 0 -3px; }
+.template-card { position: relative; min-width: 0; display: flex; flex-direction: column;
+  scroll-snap-align: start; overflow: hidden; text-align: left; padding: 0;
+  border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: var(--fg);
+  cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
+.template-card:hover { border-color: var(--brand-600); transform: translateY(-1px); }
+.template-card.active { border-color: var(--brand-600); box-shadow: 0 0 0 2px rgba(26, 115, 232, .12); }
+.template-card.picked { border: 2px solid var(--brand-600); background: var(--brand-50, #eef5ff); }
+.template-card-image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
+  background: var(--gray-100, #f2f4f7); border-bottom: 1px solid var(--border); }
+.template-card-placeholder { display: flex; align-items: center; justify-content: center;
+  color: var(--fg-faint); font-size: 12px; }
+.template-card-name { display: block; padding: 9px 10px 2px; font-size: 13px; line-height: 1.4;
+  font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.template-card-meta { display: -webkit-box; padding: 0 10px 10px; color: var(--fg-muted); font-size: 11px;
+  line-height: 1.35; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.template-card-check { position: absolute; top: 7px; right: 7px; width: 23px; height: 23px;
+  display: none; align-items: center; justify-content: center; border-radius: 999px;
+  color: #fff; background: var(--brand-600); box-shadow: 0 2px 8px rgb(0 0 0 / .2); }
+.template-card-check .ui-icon { width: 14px; height: 14px; }
+.template-card.picked .template-card-check { display: inline-flex; }
+.template-detail { display: grid; grid-template-columns: minmax(220px, .9fr) minmax(260px, 1.1fr);
+  gap: 18px; margin-top: 12px; padding: 14px; border: 1px solid var(--border);
+  border-radius: 13px; background: var(--bg); }
+.template-detail-media { min-width: 0; aspect-ratio: 16 / 9; overflow: hidden;
+  border-radius: 10px; background: #111; }
+.template-detail-media video, .template-detail-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.template-detail-media-empty { width: 100%; height: 100%; display: flex; align-items: center;
+  justify-content: center; color: #adb5bd; font-size: 13px; }
+.template-detail-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
+.template-detail-title { font-size: 17px; line-height: 1.35; font-weight: 750; }
+.template-detail-meta { margin-top: 5px; color: var(--fg-muted); font-size: 12px; line-height: 1.5; }
+.template-detail-description { margin-top: 10px; color: var(--fg-muted); font-size: 12.5px; line-height: 1.65;
+  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
+.template-detail-description.expanded { display: block; overflow: visible; }
+.template-detail-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 13px; }
+.template-detail-actions button { min-height: 36px; display: inline-flex; align-items: center; justify-content: center;
+  gap: 5px; padding: 7px 13px; border: 1px solid var(--border); border-radius: 8px;
+  background: var(--surface); color: var(--fg); font: inherit; font-size: 12.5px; cursor: pointer; }
+.template-detail-actions button:hover { border-color: var(--brand-600); }
+.template-detail-actions .template-detail-use { border-color: var(--brand-600); background: var(--brand-600);
+  color: #fff; font-weight: 700; }
+@media (max-width: 760px) {
+  .template-catalog-box { padding: 13px 12px 14px; }
+  .template-card-rail { grid-auto-columns: clamp(244px, 78vw, 292px); gap: 10px; }
+  .template-detail { grid-template-columns: 1fr; gap: 12px; padding: 11px; }
+  .template-detail-actions { width: 100%; }
+  .template-detail-actions button { flex: 1 1 130px; min-height: 44px; }
+}
 /* 样音采集组件（voice_sample，2026-09-15 结构化改造）：跟读稿 + 动作按钮 */
 .voice-sample-body { display: flex; flex-direction: column; gap: 10px; }
 .voice-sample-body .vs-script { font-size: 13px; line-height: 1.7; color: var(--fg);
