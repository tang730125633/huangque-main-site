diff --git a/agent/v4/state.py b/agent/v4/state.py
index 9b7575e..225af01 100644
--- a/agent/v4/state.py
+++ b/agent/v4/state.py
@@ -556,25 +556,61 @@ def get_active_widget_batch(sid: str) -> int | None:
         return _active_widget_batch.get(sid)
 
 
-def add_widgets(sid: str, widgets: list):
+def _widget_item_ids(widget: dict) -> set[str]:
+    return {
+        str(item.get("id") or "").strip()
+        for item in (widget.get("items") or [])
+        if isinstance(item, dict) and str(item.get("id") or "").strip()
+    }
+
+
+def _is_template_catalog(widget: dict) -> bool:
+    # `layout` 是展示提示，可被模型原样传入；稳定 ID 才是系统目录身份。
+    return bool(widget) and widget.get("id") == "template_catalog"
+
+
+def _duplicates_template_catalog(widget: dict, catalog: dict) -> bool:
+    """按模板 ID 判定模型自建目录；不依赖模型可自由改写的标题。"""
+    if not widget or _is_template_catalog(widget):
+        return False
+    if widget.get("type") != "option_pick" or widget.get("selection_mode") == "multiple":
+        return False
+    candidate_ids = _widget_item_ids(widget)
+    catalog_ids = _widget_item_ids(catalog)
+    return len(candidate_ids) >= 2 and candidate_ids.issubset(catalog_ids)
+
+
+def add_widgets(sid: str, widgets: list) -> int:
     """追加卡片；同 id 的旧卡片会被替换（避免重复渲染）。
     每次注册同 id 卡片 gen+1：前端按 id@gen 记忆「已关闭」，
     用户明确要求（子 Agent 重新查询注册）时 gen 变化，卡片才会重新出现。
     同时作废「查不到」的旧选择（幽灵形象卡：素材被清理/换批次后旧选择 id
-    已不在当批卡片里——不撤销的话前端「已选汇总」会一直把不存在的 id 报回后端）。"""
+    已不在当批卡片里——不撤销的话前端「已选汇总」会一直把不存在的 id 报回后端）。
+    返回实际写入的卡片数；与标准模板目录重复的模型自建 option_pick 会被忽略。
+    当标准目录后到时，也会清掉会话中已经存在的重复目录，兼容旧调用顺序。"""
     with _lock:
         cur = _widgets.setdefault(sid, [])
         by_id = {w.get("id"): w for w in cur}
+        accepted = 0
         for w in widgets or []:
             w = dict(w)
             wid = w.get("id")
+            catalog = next((item for item in by_id.values() if _is_template_catalog(item)), None)
+            if catalog and _duplicates_template_catalog(w, catalog):
+                continue
             old = by_id.get(wid)
             w["gen"] = (old.get("gen") or 0) + 1 if old else 1
             if sid in _active_widget_batch:
                 w["batch"] = _active_widget_batch[sid]
             by_id[wid] = w
+            accepted += 1
+            if _is_template_catalog(w):
+                for old_id, old_widget in list(by_id.items()):
+                    if old_id != wid and _duplicates_template_catalog(old_widget, w):
+                        by_id.pop(old_id, None)
         _widgets[sid] = list(by_id.values())
         _prune_ghost_selections(sid)
+        return accepted
 
 
 _SELECTION_WIDGET_TYPE = {"avatar": "avatar_pick", "voice": "voice_pick", "script": "script_pick"}
