                     img = re.sub(r"^https?://huangquechuanmei\.com(?=/api/)", "", img)
                     it["image_url"] = img
             clean.append(w)
-        if clean:
-            state.add_widgets(sid, clean)
+        attached = state.add_widgets(sid, clean) if clean else 0
         task = args.get("task")
         if isinstance(task, dict):
             state.set_widget_task(sid, task)
         else:
             state.set_widget_task_title(sid, str(args.get("task_title") or ""))
-        return {"ok": True, "note": f"已注册 {len(clean)} 张交互卡片（用户点选后会以【点选】消息回来）"}
+        return {
+            "ok": True,
+            "attached": attached,
+            "suppressed": len(clean) - attached,
+            "note": f"已注册 {attached} 张交互卡片（用户点选后会以【点选】消息回来）",
+        }
 
     if name == "chatcut_tools":
         if domain != "clip":
diff --git a/static/v4.js b/static/v4.js
index 8f8ad01..e11a60b 100644
--- a/static/v4.js
+++ b/static/v4.js
@@ -3030,8 +3030,29 @@
     });
   }
 
+  function filterDuplicateTemplateCatalogWidgets(widgets) {
+    var catalog = (widgets || []).find(function (w) { return w && w.id === "template_catalog"; });
+    if (!catalog) {
+      catalog = (widgets || []).find(function (w) { return w && w.layout === "template_catalog"; });
+    }
+    if (!catalog) return widgets || [];
+    var catalogIds = {};
+    (catalog.items || []).forEach(function (item) {
+      var id = String((item && item.id) || "").trim();
+      if (id) catalogIds[id] = true;
+    });
+    return (widgets || []).filter(function (w) {
+      if (!w || w === catalog || w.id === "template_catalog") return true;
+      if (w.type !== "option_pick" || w.selection_mode === "multiple") return true;
+      var ids = (w.items || []).map(function (item) {
+        return String((item && item.id) || "").trim();
+      }).filter(Boolean);
+      return ids.length < 2 || !ids.every(function (id) { return catalogIds[id]; });
+    });
+  }
+
   function renderWidgets(widgets, opts) {
-    widgets = widgets || [];
+    widgets = filterDuplicateTemplateCatalogWidgets(widgets || []);
     opts = opts || {};
     // filmMode：true 只渲染出片卡（出片轮调用）；false 只渲染非出片卡
     // （audio 域的音色/声音克隆槽位卡——非出片轮也要让用户点选，不能卸）。
