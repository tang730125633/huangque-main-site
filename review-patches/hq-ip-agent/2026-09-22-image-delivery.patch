                 "images": list(m.get("images") or []),
-                "job": m.get("media_job"),
+                "job": m.get("media_job") or str(m.get("task_job")),
             })
         elif m.get("task_job") and m.get("content"):
             content = m.get("content")
             cover = ""
+            images = list(task_images.get(str(m.get("task_job"))) or [])
