                 base = u.split("?")[0].lower()
                 if not cover and base.endswith((".jpg", ".jpeg", ".png", ".webp", ".gif")):
-                    cover = u
+                    if m.get("task_domain") in ("image", "hq-image"):
+                        if u not in images:
+                            images.append(u)
+                    else:
+                        cover = u
                 elif base.endswith((".mp4", ".mov", ".webm")) and len(videos) < 3:
                     videos.append({"url": u, "cover": cover})
             deliveries.append({
                 "reply": content,
-                "images": [],
+                "images": images[:3],
                 "videos": videos,
                 "job": str(m.get("task_job")),
             })
