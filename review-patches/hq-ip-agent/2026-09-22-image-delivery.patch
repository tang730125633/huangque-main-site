diff --git a/tests/hq-job-watcher-test.py b/tests/hq-job-watcher-test.py
index 25bd4c1..b28d59c 100644
--- a/tests/hq-job-watcher-test.py
+++ b/tests/hq-job-watcher-test.py
@@ -153,0 +154,159 @@ assert_ok(not _contradiction, "无图采集交付不再说「图片在下面」
+# ⑤ 普通图片任务完成后，产物必须进入历史消息和实时 delivery 事件。
+# 这是 2026-09-22 任务 9807 的真实故障模式：上游 result.url 有 PNG，
+# 但消息 images 与 SSE images 都为空，Agent 随后却声称“图片卡片已发出”。
+SID4 = "watcher-image-delivery-sid"
+IMAGE_URL = "https://media.example.com/output-9807.webp?signature=unit"
+v4_state.set_owner(SID4, OWNER)
+v4_state.is_loaded(SID4)
+_events4 = []
+_spawned5 = []
+_original_emit = v4_delivery.streaming.emit
+v4_delivery.streaming.emit = lambda sid, event, data: _events4.append((sid, event, data))
+v4_delivery.set_turn_spawner(lambda sid, text: _spawned5.append((sid, text)) or 1)
+try:
+    v4_delivery.deliver_terminal(SID4, "image", 999904, "completed", {
+        "id": 999904,
+        "job_id": 999904,
+        "status": "done",
+        "result": {"url": IMAGE_URL, "urls": [IMAGE_URL], "count": 1},
+    })
+finally:
+    v4_delivery.set_turn_spawner(None)
+    v4_delivery.streaming.emit = _original_emit
+
+_hist4 = v4_state.get_main_history(SID4)
+_image_msg4 = next((m for m in reversed(_hist4)
+                    if str(m.get("task_job")) == "999904"), {})
+assert_ok(_image_msg4.get("images") == [IMAGE_URL],
+          "图片任务产物写入历史消息 images")
+assert_ok(any(event == "delivery" and data.get("images") == [IMAGE_URL]
+              for _, event, data in _events4),
+          "图片任务产物写入实时 delivery 事件")
+assert_ok(v4_delivery.product_urls("image", {
+              "url": IMAGE_URL,
+              "audio_url": "https://media.example.com/output-9807.mp3",
+              "video_url": "https://media.example.com/output-9807.mp4",
+          }) == [IMAGE_URL],
+          "短域名图片任务只把图片产物送进任务面板兜底")
+assert_ok(v4_delivery.product_urls("hq-image", {"url": IMAGE_URL}) == [IMAGE_URL],
+          "Agent id 域名图片任务同样只交付图片")
+import app as hq_app
+assert_ok(any(item.get("images") == [IMAGE_URL]
+              for item in hq_app._recent_deliveries(SID4)),
+          "图片任务产物进入 SSE 断线恢复兜底")
+
+# 多图任务必须完整写入历史、实时事件与恢复兜底，不能静默只交付前三张。
+SID7 = "watcher-multi-image-delivery-sid"
+MULTI_IMAGES = [
+    "https://media.example.com/multi-%d.webp?signature=unit" % i
+    for i in range(1, 6)
+]
+v4_state.set_owner(SID7, OWNER)
+v4_state.is_loaded(SID7)
+_events7 = []
+_original_emit = v4_delivery.streaming.emit
+v4_delivery.streaming.emit = lambda sid, event, data: _events7.append((sid, event, data))
+try:
+    v4_delivery.deliver_terminal(SID7, "hq-image", 999907, "completed", {
+        "id": 999907, "job_id": 999907, "status": "done",
+        "result": {"urls": MULTI_IMAGES, "count": len(MULTI_IMAGES)},
+    })
+finally:
+    v4_delivery.streaming.emit = _original_emit
+_multi_message = next(m for m in reversed(v4_state.get_main_history(SID7))
+                      if str(m.get("task_job")) == "999907")
+assert_ok(_multi_message.get("images") == MULTI_IMAGES,
+          "多图任务全部写入历史消息 images")
+assert_ok(any(event == "delivery" and data.get("images") == MULTI_IMAGES
+              for _, event, data in _events7),
+          "多图任务全部写入实时 delivery 事件")
+assert_ok(any(item.get("images") == MULTI_IMAGES
+              for item in hq_app._recent_deliveries(SID7)),
+          "多图任务全部进入断线恢复兜底")
+
+# 任务面板只认结构化 task_job/media_job；正文偶然提到同号不能绑定无关媒体。
+_history_products = [
+    {"role": "assistant", "content":
+     "稍后再看任务 999908：https://media.example.com/unrelated.mp4"},
+    {"role": "assistant", "content": "任务 999908 ✅ 已完成。",
+     "task_job": "999908", "task_domain": "video",
+     "images": ["https://media.example.com/wrong-domain.png"]},
+    {"role": "assistant", "content": "任务 999908 ✅ 已完成。",
+     "task_job": "999908", "task_domain": "image", "images": MULTI_IMAGES},
+]
+_anchor, _products = hq_app._task_history_products(
+    _history_products, "999908", "image")
+assert_ok(_anchor == 2 and _products == MULTI_IMAGES,
+          "任务面板按结构化任务标记与业务域精确关联全部图片")
+assert_ok(hq_app._task_history_products(
+              _history_products[:1], "999908", "image") == (None, []),
+          "正文偶然提到任务号不能误绑定无关媒体")
+assert_ok(hq_app._task_result({
+              "output": {"job_id": 999909, "result": {"urls": MULTI_IMAGES}},
+              "result": {"id": 111111},
+          }).get("job_id") == 999909,
+          "统一任务记录解包保留 output 仅有 job_id 的权威结果")
+
+# 旧版历史已写 task_job 但漏了 images：部署修复后应从持久化任务结果自动补回，
+# 不要求用户重新扣点生成，也不直接改线上会话文件。
+SID6 = "watcher-legacy-image-delivery-sid"
+LEGACY_IMAGE_URL = "https://media.example.com/legacy-9807.png?signature=unit"
+v4_state.set_owner(SID6, OWNER)
+v4_state.is_loaded(SID6)
+v4_state.save_subagent(SID6, "image", last_result={
+    "state": v4_protocol.COMPLETED,
+    "_runtime_jobs": [{
+        "state": v4_protocol.COMPLETED,
+        "result": {"id": 999906, "job_id": 999906},
+        "output": {
+            "id": 999906, "job_id": 999906, "status": "done",
+            "result": {"url": LEGACY_IMAGE_URL, "count": 1},
+        },
+    }],
+})
+v4_state.append_main_history(SID6, [{
+    "role": "assistant", "content": "任务 999906 ✅ 已完成。",
+    "task_job": "999906", "task_domain": "image",
+}])
+assert_ok(any(item.get("images") == [LEGACY_IMAGE_URL]
+              for item in hq_app._recent_deliveries(SID6)),
+          "旧版漏图消息从任务台账自动恢复图片")
+for offset in range(6):
+    v4_state.append_main_history(SID6, [{
+        "role": "assistant", "content": "较新的任务 %d 已完成" % offset,
+        "task_job": "new-%d" % offset, "task_domain": "video",
+    }])
+_recovered_history = hq_app._history_with_recovered_images(
+    SID6, v4_state.get_main_history(SID6))
+_legacy_message = next(m for m in _recovered_history
+                       if str(m.get("task_job")) == "999906")
+assert_ok(_legacy_message.get("images") == [LEGACY_IMAGE_URL],
+          "旧任务即使排在最近五条之外，恢复历史仍从台账补回图片")
+_wrong_domain = hq_app._history_with_recovered_images(SID6, [{
+    "role": "assistant", "content": "同号视频任务", "task_job": "999906",
+    "task_domain": "video",
+}])[0]
+assert_ok(not _wrong_domain.get("images"),
+          "跨业务域同号任务不能从图片台账误补产物")
+assert_ok(any("已经" in prompt and "卡片" in prompt for _, prompt in _spawned5),
+          "成功交付图片后才允许 Agent 说明卡片已发送")
+
+# ⑥ completed 但没有可交付产物时，回注必须明确禁止 Agent 谎称已发卡片。
+SID5 = "watcher-image-missing-sid"
+v4_state.set_owner(SID5, OWNER)
+v4_state.is_loaded(SID5)
+_spawned6 = []
+v4_delivery.set_turn_spawner(lambda sid, text: _spawned6.append((sid, text)) or 1)
+try:
+    v4_delivery.deliver_terminal(SID5, "hq-image", 999905, "completed", {
+        "id": 999905,
+        "job_id": 999905,
+        "status": "done",
+        "result": {"count": 1},
+    })
