+def product_urls(domain: str, value, limit: int = 3) -> list:
+    """返回任务面板使用的领域成品 URL；图片任务不能再走“只取视频”的旧兜底。"""
+    media = _product_media(domain, value)
+    return (media["videos"] + media["audios"] + media["images"])[:limit]
+
