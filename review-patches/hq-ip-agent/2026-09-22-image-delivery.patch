From ca766cd7a42c4a18644a0e7ae7e60ac78a47e370 Mon Sep 17 00:00:00 2001
From: LU-003 <293645289+LU-003@users.noreply.github.com>
Date: Tue, 22 Sep 2026 16:06:25 +0800
Subject: [PATCH] fix(ip12): deliver image task products

Pure image task results were classified but dropped because delivery only emitted video URLs and always sent an empty images list. Persist and stream image products, recover legacy missing cards from task state, and prevent follow-up claims when no product was extracted.
---
 agent/v4/delivery.py               | 70 +++++++++++++++--------
 app.py                             | 43 ++++++++++++--
 tests/hq-delivery-fallback-test.py |  7 ++-
 tests/hq-job-watcher-test.py       | 90 ++++++++++++++++++++++++++++++
 4 files changed, 179 insertions(+), 31 deletions(-)

diff --git a/agent/v4/delivery.py b/agent/v4/delivery.py
index bdd11e2..35c0592 100644
--- a/agent/v4/delivery.py
+++ b/agent/v4/delivery.py
@@ -158,3 +158,6 @@ _IMAGE_URL_RE = re.compile(r"\.(?:jpe?g|png|webp|gif)(?:[?#]|$)", re.I)
-_VIDEO_PRODUCT_DOMAINS = {"hq-video", "hq-digital-human", "hq-clip", "hq-compose"}
-_AUDIO_PRODUCT_DOMAINS = {"hq-audio"}
-_IMAGE_PRODUCT_DOMAINS = {"hq-image"}
+_VIDEO_PRODUCT_DOMAINS = {
+    "video", "digital-human", "clip", "compose",
+    "hq-video", "hq-digital-human", "hq-clip", "hq-compose",
+}
+_AUDIO_PRODUCT_DOMAINS = {"audio", "hq-audio"}
+_IMAGE_PRODUCT_DOMAINS = {"image", "hq-image"}
@@ -216,0 +220,18 @@ def _media_urls(value) -> dict:
+def _product_media(domain: str, value) -> dict:
+    """按任务域挑选真正应交付的产物，避免把封面、配音等副产物混成成品。"""
+    media = _media_urls(value)
+    if domain in _VIDEO_PRODUCT_DOMAINS:
+        return {"videos": media["videos"], "audios": [], "images": []}
+    if domain in _AUDIO_PRODUCT_DOMAINS:
+        return {"videos": [], "audios": media["audios"], "images": []}
+    if domain in _IMAGE_PRODUCT_DOMAINS:
+        return {"videos": [], "audios": [], "images": media["images"]}
+    return media
+
+
+def product_urls(domain: str, value, limit: int = 3) -> list:
+    """返回任务面板使用的领域成品 URL；图片任务不能再走“只取视频”的旧兜底。"""
+    media = _product_media(domain, value)
+    return (media["videos"] + media["audios"] + media["images"])[:limit]
+
+
@@ -245 +266 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
-        media = _media_urls(payload)
+        media = _product_media(domain, payload)
@@ -247,9 +268,3 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
-        # 贴进正文的链接按产品类型收敛：视频产品只贴视频；音频/图片产品贴对应链接；
-        # 其它域（画布/线索/文案等）保持旧行为照贴全部公网链接。
-        text_urls = list(urls)
-        if domain in _AUDIO_PRODUCT_DOMAINS:
-            text_urls += media["audios"]
-        elif domain in _IMAGE_PRODUCT_DOMAINS:
-            text_urls += media["images"]
-        elif domain not in _VIDEO_PRODUCT_DOMAINS:
-            text_urls += media["audios"] + media["images"]
+        # 视频/音频沿用正文链接渲染；图片走结构化 images，避免同一图片被正文 URL 再渲染一次。
+        text_urls = list(urls) + media["audios"][:3]
+        image_urls = media["images"][:3]
@@ -276,0 +292 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
+        if text_urls:
@@ -277,0 +294 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
+        delivered_media = bool(urls or media["audios"] or image_urls)
@@ -286 +303,2 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
-            {"role": "assistant", "content": text, "task_job": str(job_id), "task_domain": domain},
+            {"role": "assistant", "content": text, "images": image_urls,
+             "task_job": str(job_id), "task_domain": domain},
@@ -292 +310 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
-            "images": [],
+            "images": image_urls,
@@ -301,8 +319,14 @@ def deliver_terminal(sid: str, domain: str, job_id, terminal: str, payload: dict
-                _TURN_SPAWNER(sid, (
-                    "（系统事件，用户不可见：%s 任务 %s 的完成消息已推给用户。"
-                    "请用一两句话自然收尾本次交付：产物是什么、存在哪里、想改想重做怎么说；"
-                    "若你此前向用户承诺过「等它好了再做××」（如配 BGM、接着出下一步），"
-                    "现在就检查承诺并立即执行，不要等用户催。"
-                    "绝对不要再贴视频/图片/音频链接：成片链接已经以卡片单独发在对话里，"
-                    "再贴一遍会重复出现一张点不开的卡，用户已投诉。）" % (domain, job_id)
-                ))
+                if delivered_media:
+                    followup = (
+                        "（系统事件，用户不可见：%s 任务 %s 已完成，产物已经以卡片或链接实际发送给用户。"
+                        "请用一两句话自然收尾：说明产物是什么、在哪里、想修改或重做怎么说；"
+                        "若此前承诺完成后继续下一步，现在立即履行，不要等用户催。"
+                        "不要重复粘贴媒体链接，避免重复卡片。）" % (domain, job_id)
+                    )
+                else:
+                    followup = (
+                        "（系统事件，用户不可见：%s 任务 %s 状态已完成，但交付层未提取到任何可展示产物。"
+                        "不要声称图片、视频、音频或卡片已经发送，也不要说产物就在下方。"
+                        "请如实说明暂未拿到可展示结果，并先查询任务或恢复产物后再交付。）" % (domain, job_id)
+                    )
+                _TURN_SPAWNER(sid, followup)
diff --git a/app.py b/app.py
index 6cc908a..31af4b3 100644
--- a/app.py
+++ b/app.py
@@ -439,0 +440,5 @@ def v4_tasks(sid):
+            for u in m.get("images") or []:
+                if u not in urls:
+                    urls.append(u)
+                if len(urls) >= 3:
+                    break
@@ -448 +453 @@ def v4_tasks(sid):
-            urls = v4_delivery._result_urls(t.get("result") or {})
+            urls = v4_delivery.product_urls(t.get("domain") or "", t.get("result") or {})
@@ -943,0 +949,22 @@ v4_subagent.set_running_job_hook(v4_delivery.watch_sid)
+def _task_image_products(sid: str) -> dict:
+    """从任务台账补回旧版未写入历史的图片产物，供断线/刷新恢复使用。"""
+    products = {}
+    if not hasattr(v4_state, "all_domains") or not hasattr(v4_state, "get_subagent"):
+        return products
+    for domain in v4_state.all_domains(sid):
+        if domain not in ("image", "hq-image"):
+            continue
+        sess = v4_state.get_subagent(sid, domain) or {}
+        for job in v4_subagent._job_records(sess.get("last_result") or {}):
+            if job.get("state") != "completed":
+                continue
+            result = job.get("output") if isinstance(job.get("output"), dict) else {}
+            if not result.get("id") and not result.get("job_id"):
+                result = job.get("result") or {}
+            job_id = result.get("job_id") or result.get("id")
+            urls = v4_delivery.product_urls(domain, result.get("result") or {})
+            if job_id and urls:
+                products[str(job_id)] = urls
+    return products
+
+
@@ -951,0 +979 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
+    task_images = _task_image_products(sid)
@@ -954 +982 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-        if m.get("images") and m.get("media_job"):
+        if m.get("images") and (m.get("media_job") or m.get("task_job")):
@@ -958 +986 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                "job": m.get("media_job"),
+                "job": m.get("media_job") or str(m.get("task_job")),
@@ -962,0 +991 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
+            images = list(task_images.get(str(m.get("task_job"))) or [])
@@ -967 +996,5 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                    cover = u
+                    if m.get("task_domain") in ("image", "hq-image"):
+                        if u not in images:
+                            images.append(u)
+                    else:
+                        cover = u
@@ -972 +1005 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                "images": [],
+                "images": images[:3],
diff --git a/tests/hq-delivery-fallback-test.py b/tests/hq-delivery-fallback-test.py
index 4ebbbef..875c98e 100644
--- a/tests/hq-delivery-fallback-test.py
+++ b/tests/hq-delivery-fallback-test.py
@@ -54 +54 @@ assert_ok(d[0]["videos"] == [{"url": MP4, "cover": COVER}],
-# 2) 图片终态交付（无 mp4）：条目仍在（正文图片由前端文本渲染），videos 为空
+# 2) 旧版图片终态交付（URL 只在正文）：恢复为结构化 images，videos 为空
@@ -59,2 +59,3 @@ d = app_mod._recent_deliveries(SID)
-assert_ok(len(d) == 1 and d[0]["job"] == "9768" and d[0]["videos"] == [],
-          "图片终态交付也进清单（videos 为空）", str(d)[:140])
+assert_ok(len(d) == 1 and d[0]["job"] == "9768" and d[0]["videos"] == []
+          and d[0]["images"] == [IMG],
+          "旧版图片正文链接恢复为结构化 images", str(d)[:180])
diff --git a/tests/hq-job-watcher-test.py b/tests/hq-job-watcher-test.py
index 25bd4c1..20ec511 100644
--- a/tests/hq-job-watcher-test.py
+++ b/tests/hq-job-watcher-test.py
@@ -153,0 +154,90 @@ assert_ok(not _contradiction, "无图采集交付不再说「图片在下面」
+# ⑤ 普通图片任务完成后，产物必须进入历史消息和实时 delivery 事件。
+# 这是 2026-09-22 任务 9807 的真实故障模式：上游 result.url 有 PNG，
+# 但消息 images 与 SSE images 都为空，Agent 随后却声称“图片卡片已发出”。
+SID4 = "watcher-image-delivery-sid"
+IMAGE_URL = "https://media.example.com/output-9807.webp?signature=unit"
+v4_state.set_owner(SID4, OWNER)
+v4_state.is_loaded(SID4)
+_events4 = []
+_spawned5 = []
+_original_emit = v4_delivery.streaming.emit
+v4_delivery.streaming.emit = lambda sid, event, data: _events4.append((sid, event, data))
+v4_delivery.set_turn_spawner(lambda sid, text: _spawned5.append((sid, text)) or 1)
+try:
+    v4_delivery.deliver_terminal(SID4, "image", 999904, "completed", {
+        "id": 999904,
+        "job_id": 999904,
+        "status": "done",
+        "result": {"url": IMAGE_URL, "urls": [IMAGE_URL], "count": 1},
+    })
+finally:
+    v4_delivery.set_turn_spawner(None)
+    v4_delivery.streaming.emit = _original_emit
+
+_hist4 = v4_state.get_main_history(SID4)
+_image_msg4 = next((m for m in reversed(_hist4)
+                    if str(m.get("task_job")) == "999904"), {})
+assert_ok(_image_msg4.get("images") == [IMAGE_URL],
+          "图片任务产物写入历史消息 images")
+assert_ok(any(event == "delivery" and data.get("images") == [IMAGE_URL]
+              for _, event, data in _events4),
+          "图片任务产物写入实时 delivery 事件")
+assert_ok(v4_delivery.product_urls("image", {
+              "url": IMAGE_URL,
+              "audio_url": "https://media.example.com/output-9807.mp3",
+              "video_url": "https://media.example.com/output-9807.mp4",
+          }) == [IMAGE_URL],
+          "短域名图片任务只把图片产物送进任务面板兜底")
+assert_ok(v4_delivery.product_urls("hq-image", {"url": IMAGE_URL}) == [IMAGE_URL],
+          "Agent id 域名图片任务同样只交付图片")
+import app as hq_app
+assert_ok(any(item.get("images") == [IMAGE_URL]
+              for item in hq_app._recent_deliveries(SID4)),
+          "图片任务产物进入 SSE 断线恢复兜底")
+
+# 旧版历史已写 task_job 但漏了 images：部署修复后应从持久化任务结果自动补回，
+# 不要求用户重新扣点生成，也不直接改线上会话文件。
+SID6 = "watcher-legacy-image-delivery-sid"
+LEGACY_IMAGE_URL = "https://media.example.com/legacy-9807.png?signature=unit"
+v4_state.set_owner(SID6, OWNER)
+v4_state.is_loaded(SID6)
+v4_state.save_subagent(SID6, "image", last_result={
+    "state": v4_protocol.COMPLETED,
+    "_runtime_jobs": [{
+        "state": v4_protocol.COMPLETED,
+        "result": {"id": 999906, "job_id": 999906},
+        "output": {
+            "id": 999906, "job_id": 999906, "status": "done",
+            "result": {"url": LEGACY_IMAGE_URL, "count": 1},
+        },
+    }],
+})
+v4_state.append_main_history(SID6, [{
+    "role": "assistant", "content": "任务 999906 ✅ 已完成。",
+    "task_job": "999906", "task_domain": "image",
+}])
+assert_ok(any(item.get("images") == [LEGACY_IMAGE_URL]
+              for item in hq_app._recent_deliveries(SID6)),
+          "旧版漏图消息从任务台账自动恢复图片")
+assert_ok(any("已经" in prompt and "卡片" in prompt for _, prompt in _spawned5),
+          "成功交付图片后才允许 Agent 说明卡片已发送")
+
+# ⑥ completed 但没有可交付产物时，回注必须明确禁止 Agent 谎称已发卡片。
+SID5 = "watcher-image-missing-sid"
+v4_state.set_owner(SID5, OWNER)
+v4_state.is_loaded(SID5)
+_spawned6 = []
+v4_delivery.set_turn_spawner(lambda sid, text: _spawned6.append((sid, text)) or 1)
+try:
+    v4_delivery.deliver_terminal(SID5, "hq-image", 999905, "completed", {
+        "id": 999905,
+        "job_id": 999905,
+        "status": "done",
+        "result": {"count": 1},
+    })
+finally:
+    v4_delivery.set_turn_spawner(None)
+assert_ok(any("未提取到" in prompt and "不要声称" in prompt
+              for _, prompt in _spawned6),
+          "没有产物时禁止 Agent 声称已发送")
+
