@@ -943,0 +930,62 @@ v4_subagent.set_running_job_hook(v4_delivery.watch_sid)
+def _task_result(job: dict) -> dict:
+    """统一解包任务记录，兼容 output/result 两代结构与仅有 job_id 的 output。"""
+    result = job.get("output") if isinstance(job.get("output"), dict) else {}
+    if not result.get("id") and not result.get("job_id"):
+        result = job.get("result") if isinstance(job.get("result"), dict) else {}
+    return result
+
+
+def _task_history_products(history: list, job_id, domain: str) -> tuple:
+    """只用结构化任务标记关联消息，正文里偶然出现同号不能抢走产物。"""
+    wanted = str(job_id)
+    limit = None if domain in ("image", "hq-image") else 3
+    for index, message in enumerate(history):
+        marker = message.get("task_job") or message.get("media_job")
+        if str(marker or "") != wanted:
+            continue
+        message_domain = str(message.get("task_domain") or "")
+        if message_domain and message_domain != domain:
+            continue
+        products = v4_delivery.product_urls(domain, {
+            "content": message.get("content") or "",
+            "images": list(message.get("images") or []),
+        }, limit=limit)
+        return index, products
+    return None, []
+
+
+def _task_image_products(sid: str) -> dict:
+    """从任务台账补回旧版未写入历史的图片产物，供断线/刷新恢复使用。"""
+    products = {}
+    if not hasattr(v4_state, "all_domains") or not hasattr(v4_state, "get_subagent"):
+        return products
+    for domain in v4_state.all_domains(sid):
+        if domain not in ("image", "hq-image"):
+            continue
+        sess = v4_state.get_subagent(sid, domain) or {}
+        for job in v4_subagent._job_records(sess.get("last_result") or {}):
+            if job.get("state") != "completed":
+                continue
+            result = _task_result(job)
+            job_id = result.get("job_id") or result.get("id")
+            urls = v4_delivery.product_urls(domain, result.get("result") or {}, limit=None)
+            if job_id and urls:
+                products[str(job_id)] = urls
+    return products
+
+
+def _history_with_recovered_images(sid: str, history: list) -> list:
+    """给旧版漏图的结构化任务消息补上台账图片，不改写持久化历史。"""
+    task_images = _task_image_products(sid)
+    recovered = []
+    for message in history:
+        item = dict(message)
+        job_id = str(item.get("task_job") or "")
+        domain = str(item.get("task_domain") or "")
+        images = task_images.get(job_id) if job_id and domain in ("", "image", "hq-image") else None
+        if images and not item.get("images"):
+            item["images"] = list(images)
+        recovered.append(item)
+    return recovered
+
+
@@ -951,0 +1000 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
+    task_images = _task_image_products(sid)
@@ -953,2 +1002,3 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-    for m in reversed(v4_state.get_main_history(sid)):
-        if m.get("images") and m.get("media_job"):
+    history = _history_with_recovered_images(sid, v4_state.get_main_history(sid))
+    for m in reversed(history):
+        if m.get("images") and (m.get("media_job") or m.get("task_job")):
@@ -958 +1008 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                "job": m.get("media_job"),
+                "job": m.get("media_job") or str(m.get("task_job")),
@@ -962,0 +1013 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
+            images = list(task_images.get(str(m.get("task_job"))) or [])
@@ -967 +1018,5 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                    cover = u
+                    if m.get("task_domain") in ("image", "hq-image"):
+                        if u not in images:
+                            images.append(u)
+                    else:
+                        cover = u
@@ -972 +1027 @@ def _recent_deliveries(sid: str, cap: int = 5) -> list:
-                "images": [],
+                "images": images,
@@ -1975,0 +2031 @@ def v4_restore(sid):
+    history = _history_with_recovered_images(sid, history)
