From e171264688077d44b225faf9b2c8f13825769d6a Mon Sep 17 00:00:00 2001
From: LU-003 <LU-003@users.noreply.github.com>
Date: Tue, 22 Sep 2026 11:41:23 +0800
Subject: [PATCH] fix(ip12): keep onboarding composer accessible

---
 static/style.css       |  16 +++++++
 static/v4.js           |  24 +++++++++-
 tests/hq-ip12-test.mjs | 101 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 140 insertions(+), 1 deletion(-)

diff --git a/static/style.css b/static/style.css
index e3b80a7..6ddbba3 100644
--- a/static/style.css
+++ b/static/style.css
@@ -1210,0 +1211 @@ button { font-family: inherit; }
+.main-col:has(#capability-launcher:not([hidden])) .example-grid { display: none; }
@@ -1418,0 +1420,15 @@ button { font-family: inherit; }
+  .main-col:has(#capability-launcher:not([hidden])) .intro {
+    flex: 0 0 auto; padding: 18px 0 12px; overflow: visible;
+  }
+  .main-col:has(#capability-launcher:not([hidden])) .eyebrow { margin-bottom: 8px; }
+  .main-col:has(#capability-launcher:not([hidden])) .intro-title { font-size: 28px; margin-bottom: 6px; }
+  .main-col:has(#capability-launcher:not([hidden])) .intro-sub { margin-bottom: 0; }
+  .main-col:has(#capability-launcher:not([hidden])):has(#input:not(:placeholder-shown)) .intro {
+    display: none;
+  }
+  .main-col:has(#capability-launcher:not([hidden])) .capability-launcher {
+    flex: 0 1 auto; min-height: 0; max-height: none; margin-bottom: 10px; overflow-y: auto;
+  }
+  .main-col:has(#capability-launcher:not([hidden])) .messages {
+    min-height: 72px; padding-top: 12px; padding-bottom: 14px;
+  }
diff --git a/static/v4.js b/static/v4.js
index 6552b65..f94a6ef 100644
--- a/static/v4.js
+++ b/static/v4.js
@@ -4601 +4601,23 @@
-    return { min: 44, max: Math.max(140, Math.round(window.innerHeight * 0.62) - 150) };
+    var min = 44;
+    var max = Math.max(140, Math.round(window.innerHeight * 0.62) - 150);
+    var desktopOnboarding = false;
+    try {
+      desktopOnboarding = window.matchMedia("(min-width: 901px)").matches
+        && capLauncher && !capLauncher.hidden;
+    } catch (e) {}
+    if (desktopOnboarding) {
+      var mainCol = input.closest(".main-col");
+      var composerWrap = composer && composer.parentElement;
+      if (mainCol && composerWrap) {
+        var mainRect = mainCol.getBoundingClientRect();
+        var wrapRect = composerWrap.getBoundingClientRect();
+        var inputHeight = input.getBoundingClientRect().height || min;
+        var visibleBottom = Math.min(window.innerHeight, mainRect.bottom);
+        var launcherHeight = capLauncher.getBoundingClientRect().height;
+        var launcherFloor = Math.min(120, capLauncher.scrollHeight || 120);
+        var launcherShrinkRoom = Math.max(0, launcherHeight - launcherFloor);
+        var available = Math.floor(visibleBottom - wrapRect.bottom + inputHeight + launcherShrinkRoom);
+        max = Math.min(max, Math.max(140, available));
+      }
+    }
+    return { min: min, max: max };
diff --git a/tests/hq-ip12-test.mjs b/tests/hq-ip12-test.mjs
index 62cbeaf..1fd96fd 100644
--- a/tests/hq-ip12-test.mjs
+++ b/tests/hq-ip12-test.mjs
@@ -154,0 +155,100 @@ async function mockRoutes(page, opts) {
+  const onboardingLayout = await page.evaluate(() => {
+    const regionIds = ['intro', 'capability-launcher', 'messages'];
+    const scrollableRegions = regionIds.filter((id) => {
+      const node = document.getElementById(id);
+      const style = getComputedStyle(node);
+      return /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 2;
+    });
+    const composerRect = document.querySelector('.composer-wrap').getBoundingClientRect();
+    return {
+      exampleGridDisplay: getComputedStyle(document.getElementById('example-grid')).display,
+      scrollableRegions,
+      composerInsideViewport: composerRect.top >= 0 && composerRect.bottom <= window.innerHeight + 1,
+    };
+  });
+  assert(onboardingLayout.exampleGridDisplay === 'none', '新会话不同时展示重复的 Hero 示例入口');
+  assert(onboardingLayout.scrollableRegions.length <= 1,
+    '新会话欢迎区、能力区和消息区最多一个滚动容器（实际=' + JSON.stringify(onboardingLayout.scrollableRegions) + '）');
+  assert(onboardingLayout.composerInsideViewport, '新会话输入框完整保留在首屏视口内');
+  await page.setViewportSize({ width: 1920, height: 1080 });
+  const wideOnboardingScrollers = await page.evaluate(() => ['intro', 'capability-launcher', 'messages'].filter((id) => {
+    const node = document.getElementById(id);
+    const style = getComputedStyle(node);
+    return /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 2;
+  }));
+  assert(wideOnboardingScrollers.length <= 1,
+    '1920×1080 新会话最多一个滚动容器（实际=' + JSON.stringify(wideOnboardingScrollers) + '）');
+  await page.setViewportSize({ width: 1280, height: 768 });
+  const compactOnboarding = await page.evaluate(() => {
+    const regionIds = ['intro', 'capability-launcher', 'messages'];
+    const scrollableRegions = regionIds.filter((id) => {
+      const node = document.getElementById(id);
+      const style = getComputedStyle(node);
+      return /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 2;
+    });
+    const launcher = document.getElementById('capability-launcher');
+    const composerRect = document.querySelector('.composer-wrap').getBoundingClientRect();
+    launcher.scrollTop = launcher.scrollHeight;
+    const lastCardRect = launcher.querySelector('.capability-card:last-child').getBoundingClientRect();
+    const launcherRect = launcher.getBoundingClientRect();
+    const lastCardReachable = lastCardRect.top >= launcherRect.top - 1 && lastCardRect.bottom <= launcherRect.bottom + 1;
+    launcher.scrollTop = 0;
+    return {
+      scrollableRegions,
+      composerInsideViewport: composerRect.top >= 0 && composerRect.bottom <= window.innerHeight + 1,
+      lastCardReachable,
+    };
+  });
+  assert(compactOnboarding.composerInsideViewport, '1280×768 新会话输入框完整保留在视口内');
+  assert(compactOnboarding.scrollableRegions.length <= 1
+      && compactOnboarding.scrollableRegions.every((id) => id === 'capability-launcher'),
+    '1280×768 新会话只允许能力区按需滚动（实际=' + JSON.stringify(compactOnboarding.scrollableRegions) + '）');
+  assert(compactOnboarding.lastCardReachable, '1280×768 能力区可滚动访问全部 8 张能力卡');
+  await page.setViewportSize({ width: 1280, height: 650 });
+  const shortOnboarding = await page.evaluate(() => {
+    const composerRect = document.querySelector('.composer-wrap').getBoundingClientRect();
+    const scrollableRegions = ['intro', 'capability-launcher', 'messages'].filter((id) => {
+      const node = document.getElementById(id);
+      const style = getComputedStyle(node);
+      return /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 2;
+    });
+    return {
+      scrollableRegions,
+      composerInsideViewport: composerRect.top >= 0 && composerRect.bottom <= window.innerHeight + 1,
+    };
+  });
+  assert(shortOnboarding.composerInsideViewport, '1280×650 新会话输入框完整保留在视口内');
+  assert(shortOnboarding.scrollableRegions.length <= 1
+      && shortOnboarding.scrollableRegions.every((id) => id === 'capability-launcher'),
+    '1280×650 新会话只允许能力区按需滚动（实际=' + JSON.stringify(shortOnboarding.scrollableRegions) + '）');
+  await page.setViewportSize({ width: 1280, height: 900 });
+
+  await page.fill('#input', '长文本输入 '.repeat(300));
+  await page.waitForTimeout(150);
+  assert(await page.$eval('#intro', (n) => getComputedStyle(n).display === 'none'), '新会话长文本输入时收起 Hero 为输入区让出空间');
+  const longInput900 = await page.evaluate(() => {
+    const wrapRect = document.querySelector('.composer-wrap').getBoundingClientRect();
+    const footerRect = document.querySelector('.composer-footer').getBoundingClientRect();
+    return {
+      wrapInside: wrapRect.top >= 0 && wrapRect.bottom <= window.innerHeight + 1,
+      footerInside: footerRect.top >= 0 && footerRect.bottom <= window.innerHeight + 1,
+    };
+  });
+  assert(longInput900.wrapInside && longInput900.footerInside, '1280×900 新会话超长输入时 composer 和 footer 完整保留在视口内');
+  await page.setViewportSize({ width: 1920, height: 1080 });
+  await page.fill('#input', '长文本输入 '.repeat(301));
+  await page.waitForTimeout(100);
+  const longInput1080 = await page.evaluate(() => {
+    const wrapRect = document.querySelector('.composer-wrap').getBoundingClientRect();
+    const footerRect = document.querySelector('.composer-footer').getBoundingClientRect();
+    return {
+      wrapInside: wrapRect.top >= 0 && wrapRect.bottom <= window.innerHeight + 1,
+      footerInside: footerRect.top >= 0 && footerRect.bottom <= window.innerHeight + 1,
+    };
+  });
+  assert(longInput1080.wrapInside && longInput1080.footerInside, '1920×1080 新会话超长输入时 composer 和 footer 完整保留在视口内');
+  await page.setViewportSize({ width: 1280, height: 900 });
+  await page.fill('#input', '');
+  await page.waitForTimeout(100);
+  assert(await page.$eval('#intro', (n) => getComputedStyle(n).display !== 'none'), '新会话清空输入后恢复 Hero');
+
@@ -429,0 +530 @@ async function mockRoutes(page, opts) {
+  assert(await page.$eval('.composer-wrap', (n) => n.getBoundingClientRect().bottom <= window.innerHeight + 1), '长文本输入时输入框仍完整保留在视口内');
