Subject: [PATCH 2/2] test(ui): keep report during responsive layout check

---
 tests/hq-layout-test.mjs | 25 ++++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/tests/hq-layout-test.mjs b/tests/hq-layout-test.mjs
index 1e9a015..05ba28f 100644
--- a/tests/hq-layout-test.mjs
+++ b/tests/hq-layout-test.mjs
@@ -7,0 +8 @@ let chatSeq = 0;
+let reportActive = false;
@@ -40 +41,4 @@ await page.route('**/*', async (route) => {
-    if (turnQueue.length) return route.fulfill({ json: turnPayload(turnQueue.shift()) });
+    if (turnQueue.length) {
+      reportActive = true;
+      return route.fulfill({ json: turnPayload(turnQueue.shift()) });
+    }
@@ -43,2 +47,5 @@ await page.route('**/*', async (route) => {
-  if (url.includes('/api/v4/reset')) return route.fulfill({ json: { ok: true } });
-  if (url.includes('/api/v4/status')) return route.fulfill({ json: { turns: [], jobs: [], delegations: {}, tool: null, report: null } });
+  if (url.includes('/api/v4/reset')) {
+    reportActive = false;
+    return route.fulfill({ json: { ok: true } });
+  }
+  if (url.includes('/api/v4/status')) return route.fulfill({ json: { turns: [], jobs: [], delegations: {}, tool: null, report: reportActive ? reportPayload() : null } });
@@ -105 +112,8 @@ const narrow = await page.evaluate(() => {
-  return { dir: getComputedStyle(document.querySelector('.shell')).flexDirection, pos: getComputedStyle(p).position, paneLeft: p.getBoundingClientRect().left, mainLeft: m.getBoundingClientRect().left };
+  const shell = document.querySelector('.shell');
+  const shellStyle = getComputedStyle(shell);
+  const railStyle = getComputedStyle(p);
+  return { dir: shellStyle.flexDirection, pos: railStyle.position,
+    paneLeft: p.getBoundingClientRect().left, paneWidth: p.getBoundingClientRect().width,
+    mainLeft: m.getBoundingClientRect().left, shellLeft: shell.getBoundingClientRect().left,
+    shellWidth: shell.getBoundingClientRect().width, shellPaddingLeft: shellStyle.paddingLeft,
+    railWidth: railStyle.width, railAlign: railStyle.alignSelf };
@@ -109 +123,2 @@ assert(narrow.pos === 'static', '窄屏报告栏不再粘顶');
-assert(Math.abs(narrow.paneLeft - narrow.mainLeft) < 8, '窄屏报告与聊天同列对齐（左对齐）');
+assert(Math.abs(narrow.paneLeft - narrow.mainLeft) < 8,
+  '窄屏报告与聊天同列对齐（' + JSON.stringify(narrow) + '）');
