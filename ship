#!/usr/bin/env bash
# ship — 黄雀一键上线：校验 clean main → 部署 → 重启 → 验证
#
# 用法：  ./ship [--exact-content-domains] "提交说明" 文件1 [文件2 ...]
#   后端：./ship "修获客超时" server/leadgen_api.py
#   前端：./ship "改采集页文案" site/workbench/collect.html
#   多个：./ship "联调获客" server/leadgen_api.py site/workbench/collect.html
#
# 只发布已经合并到实时 origin/main 的干净提交。绝不在服务器上直接改。

# 密钥与主机可用环境变量覆盖：原来写死了某台开发机的路径和 ssh 别名，
# 换一台机器（如 Windows/Git Bash）就跑不起来，只能手工 scp —— 那正是 ship 要杜绝的。
SSH_KEY="${HQ_SSH_KEY:-$HOME/.ssh/dapeng_server_ed25519}"
REMOTE="${HQ_REMOTE:-dapeng-server}"
SSH_OPTS="-o IdentitiesOnly=yes"
[ -f "$SSH_KEY" ] && SSH_OPTS="-i $SSH_KEY $SSH_OPTS"
SSHC="ssh $SSH_OPTS"
WWW="/var/www/huangquechuanmei"
HEALTH_URL="${HQ_HEALTH_URL:-https://huangquechuanmei.com/api/gen/health}"
SERVICE_WAIT_SECONDS="${HQ_SERVICE_WAIT_SECONDS:-30}"
CONTENT_PYTHON="${HQ_CONTENT_PYTHON:-/usr/bin/python3}"
SHIP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CREATOR_STAGE_HELPER="$SHIP_ROOT/deploy/ship-creator-stage.sh"
[ -f "$CREATOR_STAGE_HELPER" ] \
  || { echo "❌ 缺少 Creator 暂存清理脚本：$CREATOR_STAGE_HELPER"; exit 1; }
. "$CREATOR_STAGE_HELPER" \
  || { echo "❌ Creator 暂存清理脚本加载失败"; exit 1; }

case "$SERVICE_WAIT_SECONDS" in
  ''|*[!0-9]*) echo "❌ HQ_SERVICE_WAIT_SECONDS 必须是正整数"; exit 1 ;;
  0) echo "❌ HQ_SERVICE_WAIT_SECONDS 必须大于 0"; exit 1 ;;
esac

EXACT_CONTENT_DOMAINS=0
if [ "${1:-}" = "--exact-content-domains" ]; then
  EXACT_CONTENT_DOMAINS=1
  shift
fi

[ $# -lt 2 ] && { echo "用法: ./ship [--exact-content-domains] \"提交说明\" 文件1 [文件2 ...]"; exit 1; }

# 传文件：有 rsync 就用 rsync；没有（Windows/Git Bash 自带 ssh 但没 rsync）就
# scp 到 /tmp 再 sudo 安装到位。必须保留原属主 —— 直接 sudo install 会把
# /var/www 下的文件从 www-data 变成 root。
push_file(){
  local src="$1" dir="$2" base dst
  base=$(basename "$src"); dst="${dir%/}/$base"
  if command -v rsync >/dev/null 2>&1; then
    rsync -az --rsync-path="sudo rsync" -e "$SSHC" "$src" "$REMOTE:$dir"
  else
    local tmp="/tmp/.ship.$$.$base"
    scp -q $SSH_OPTS "$src" "$REMOTE:$tmp" || return 1
    $SSHC "$REMOTE" "own=\$(stat -c '%U:%G' '$dst' 2>/dev/null || true); \
      sudo mkdir -p '$dir' && sudo install -m 644 '$tmp' '$dst' && \
      { [ -n \"\$own\" ] && sudo chown \"\$own\" '$dst' || true; }; rm -f '$tmp'"
  fi
}

# 传目录（带 --delete，清掉线上多余文件）。没有本地 rsync 时借服务器上的 rsync：
# scp 整个目录到 /tmp，再在服务器侧 rsync --delete 到位，语义完全一致。
push_dir(){
  local src="$1" dir="$2"
  if command -v rsync >/dev/null 2>&1; then
    rsync -az --delete --exclude='__pycache__' --exclude='*.db' --rsync-path="sudo rsync" -e "$SSHC" "$src" "$REMOTE:$dir"
  else
    local tmp="/tmp/.shipdir.$$"
    $SSHC "$REMOTE" "rm -rf '$tmp' && mkdir -p '$tmp'" || return 1
    scp -qr $SSH_OPTS "${src%/}/." "$REMOTE:$tmp/" || return 1
    $SSHC "$REMOTE" "sudo mkdir -p '$dir' && \
      sudo rsync -a --delete --exclude='__pycache__' --exclude='*.db' '$tmp/' '$dir' && rm -rf '$tmp'"
  fi
}
MSG="$1"; shift

# 1. 发布源必须是已合并、无本地改动的实时 main。ship 不再代替 PR 流程提交或推送。
echo "==> 1/5 校验发布源（clean main == 实时 origin/main）"
BRANCH="$(git branch --show-current 2>/dev/null)" || { echo "❌ 无法读取当前分支"; exit 1; }
[ "$BRANCH" = "main" ] || { echo "❌ 只允许从本地 main 发布（当前: ${BRANCH:-detached}）"; exit 1; }
WORKTREE_STATUS="$(git status --porcelain --untracked-files=all)" || { echo "❌ 无法检查工作区"; exit 1; }
[ -z "$WORKTREE_STATUS" ] || { echo "❌ 工作区有改动，拒绝发布；请先通过 PR 合并到 main"; exit 1; }
HEAD_SHA="$(git rev-parse HEAD 2>/dev/null)" || { echo "❌ 无法读取本地 HEAD"; exit 1; }
REMOTE_MAIN="$(git ls-remote --exit-code origin refs/heads/main 2>/dev/null)" \
  || { echo "❌ 无法读取实时 origin/main"; exit 1; }
REMOTE_MAIN="${REMOTE_MAIN%%[[:space:]]*}"
[ -n "$REMOTE_MAIN" ] && [ "$HEAD_SHA" = "$REMOTE_MAIN" ] \
  || { echo "❌ 本地 main 不是实时 origin/main，拒绝发布"; exit 1; }
git ls-files --error-unmatch -- "$@" >/dev/null 2>&1 \
  || { echo "❌ 仅允许发布当前 main 中 Git 跟踪的文件"; exit 1; }
HOME_ASSET_FILES=""
NEED_CREATOR_AGENT_RELEASE=0
CREATOR_AGENT_RELEASE_FILES=""
CREATOR_AGENT_DRIFT_FILES=""
for target in "$@"; do
  case "$target" in
    site/index.html|site/homepage.css|site/homepage-particles.js|site/assets/home/*)
      HOME_ASSET_FILES="$(git ls-files site/assets/home)" \
        || { echo "❌ 无法读取首页静态资源清单"; exit 1; }
      [ -n "$HOME_ASSET_FILES" ] \
        || { echo "❌ 首页静态资源清单为空，拒绝发布残缺首页"; exit 1; }
      break
      ;;
  esac
done
for target in "$@"; do
  case "$target" in
    server/creator_agent_api.py|server/creator_agent/*.py|deploy/creator-agent-release.sh|deploy/requirements-creator-agent.txt|deploy/systemd/huangque-creator-agent.service)
      NEED_CREATOR_AGENT_RELEASE=1
      ;;
  esac
done
if [ "$NEED_CREATOR_AGENT_RELEASE" = "1" ]; then
  CREATOR_AGENT_RUNTIME_FILES="$(git ls-files 'server/creator_agent/*.py')" \
    || { echo "❌ 无法读取 Creator Agent 运行模块清单"; exit 1; }
  [ -n "$CREATOR_AGENT_RUNTIME_FILES" ] \
    || { echo "❌ Creator Agent 运行模块清单为空"; exit 1; }
  CREATOR_AGENT_RELEASE_FILES="server/creator_agent_api.py $CREATOR_AGENT_RUNTIME_FILES \
deploy/creator-agent-release.sh deploy/requirements-creator-agent.txt \
deploy/systemd/huangque-creator-agent.service deploy/nginx-huangquechuanmei.conf"
  CREATOR_AGENT_DRIFT_FILES="server/creator_agent_api.py $CREATOR_AGENT_RUNTIME_FILES \
deploy/systemd/huangque-creator-agent.service deploy/nginx-huangquechuanmei.conf"
  git ls-files --error-unmatch -- $CREATOR_AGENT_RELEASE_FILES >/dev/null 2>&1 \
    || { echo "❌ Creator Agent 发布闭包不完整"; exit 1; }
fi
if [ "$EXACT_CONTENT_DOMAINS" = "1" ]; then
  for target in "$@"; do
    [ "$target" != "server/content_api.py" ] \
      || { echo "❌ file-only 模式不能发布 server/content_api.py（会触发 content_domains 整目录同步）"; exit 1; }
  done
fi

$SSHC -o BatchMode=yes -o ConnectTimeout=8 "$REMOTE" true 2>/dev/null || {
  echo "❌ 连不上 $REMOTE。设 HQ_REMOTE=user@host（和 HQ_SSH_KEY=私钥路径）再试。"; exit 1; }

echo "==> 2/5 发布源已锁定（不提交、不推送）"
printf "  ✓ main@%.7s | %s\n" "$HEAD_SHA" "$MSG"

# 3. 部署每个文件到对应位置 + 记下要重启的服务
echo "==> 3/5 部署到服务器"
RESTART=""
TIMERS=""
DEPLOYED=""
EXACT_DOMAIN_MODULES=""
NEED_RELOAD=0   # 部署过 systemd 单元/drop-in 时置 1，重启前必须 daemon-reload，否则改动不生效
NGINX_RELOAD=0  # 部署过 nginx 配置时置 1，走备份/nginx -t/reload 闭包
BRIDGE_DEPLOYED=""  # 发布涉及视频 Agent 桥接链路时置 1，自动补冒烟脚本与可选真实链路冒烟
CONTENT_DOMAINS_SYNCED=0
PROVIDERS_SYNCED=0
HQ_CLI_SYNCED=0
add_svc(){ for s in $1; do case " $RESTART " in *" $s "*) ;; *) RESTART="$RESTART $s";; esac; done; }
add_timer(){ for t in $1; do case " $TIMERS " in *" $t "*) ;; *) TIMERS="$TIMERS $t";; esac; done; }
add_deployed(){ case " $DEPLOYED " in *" $1 "*) ;; *) DEPLOYED="$DEPLOYED $1";; esac; }

CREATOR_LOCAL_STAGE=""
CREATOR_REMOTE_STAGE=""
trap cleanup_creator_stage EXIT

if [ "$NEED_CREATOR_AGENT_RELEASE" = "1" ]; then
  echo "  发布 Creator Agent 完整依赖闭包"
  CREATOR_LOCAL_STAGE="$(mktemp -d)"
  CREATOR_REMOTE_STAGE="/tmp/huangque-creator-agent-${HEAD_SHA}-$$"
  git archive "$HEAD_SHA" -- $CREATOR_AGENT_RELEASE_FILES \
    | tar -x -C "$CREATOR_LOCAL_STAGE" \
    || { echo "  ❌ Creator Agent 精确提交导出失败"; exit 1; }
  push_dir "$CREATOR_LOCAL_STAGE/" "$CREATOR_REMOTE_STAGE/" \
    || { echo "  ❌ Creator Agent 发布闭包上传失败"; exit 1; }
  $SSHC "$REMOTE" \
    "sudo env CREATOR_AGENT_RELEASE_SHA='$HEAD_SHA' CREATOR_AGENT_RELEASE_DIR='$CREATOR_REMOTE_STAGE' bash '$CREATOR_REMOTE_STAGE/deploy/creator-agent-release.sh'" \
    || { echo "  ❌ Creator Agent 原子发布失败，发布脚本已执行回滚"; exit 1; }
  for tracked in $CREATOR_AGENT_DRIFT_FILES; do add_deployed "$tracked"; done
  rm -rf -- "$CREATOR_LOCAL_STAGE"
  CREATOR_LOCAL_STAGE=""
  cleanup_creator_remote_stage \
    || { echo "  ❌ Creator 发布完成但暂存清理失败，已标记本次 ship 失败"; exit 1; }
  echo "  ✓ Creator Agent 完整闭包已发布并通过独立健康检查"
fi

if [ -n "$HOME_ASSET_FILES" ]; then
  $SSHC "$REMOTE" "sudo mkdir -p '$WWW/assets/home'" \
    || { echo "  ❌ 首页静态资源目录创建失败"; exit 1; }
  push_dir site/assets/home/ "$WWW/assets/home/" \
    && echo "  ✓ site/assets/home/ → $WWW/assets/home/（首页依赖闭包）" \
    || { echo "  ❌ 首页静态资源部署失败"; exit 1; }
  for tracked in $HOME_ASSET_FILES; do add_deployed "$tracked"; done
fi

show_service_diagnostics(){
  local services="${1:-${RESTART:-huangque-content}}" s
  for s in $services; do
    echo "  ── $s status / recent logs ──"
    $SSHC "$REMOTE" "sudo systemctl status '$s' --no-pager -l || true; sudo journalctl -u '$s' -n 60 --no-pager || true" || true
  done
}

wait_for_services(){
  local services="${1:-$RESTART}" s
  [ -z "$services" ] && return 0
  for s in $services; do
    echo "  等待 $s 进入 active（最多 ${SERVICE_WAIT_SECONDS}s）"
    if $SSHC "$REMOTE" "i=0; while [ \$i -lt $SERVICE_WAIT_SECONDS ]; do systemctl is-active --quiet '$s' && exit 0; i=\$((i + 1)); sleep 1; done; exit 1"; then
      echo "  ✓ $s active"
    else
      echo "  ❌ $s 在 ${SERVICE_WAIT_SECONDS}s 内未进入 active"
      show_service_diagnostics "$s"
      return 1
    fi
  done
}

# 重启前冒烟：入口模块从 systemd ExecStart 反查，不再和本脚本的映射表二次漂移。
# 缺文件/坏引用在这里暴露 → 「不重启、直接失败」，而不是重启后 ImportError 崩溃循环。
smoke_import(){
  $SSHC "$REMOTE" bash -s -- "$1" "$CONTENT_PYTHON" <<'RS'
set -u
svc="$1"; py_bin="$2"
py=$(systemctl show -p ExecStart --value "$svc" 2>/dev/null | grep -oE '/[^ ;]+\.py' | head -1)
[ -n "$py" ] || { echo "    ⏭ $svc 定位不到入口脚本，跳过冒烟"; exit 0; }
wd=$(systemctl show -p WorkingDirectory --value "$svc" 2>/dev/null); [ -n "$wd" ] || wd=$(dirname "$py")
mod=$(basename "$py" .py)
if out=$(cd "$wd" && PYTHONDONTWRITEBYTECODE=1 "$py_bin" -c "import $mod" 2>&1); then
  echo "    ✓ $svc: import $mod 通过"
else
  echo "    ❌ $svc: import $mod 失败 —— 中止，不重启（避免崩溃循环）"
  printf '%s\n' "$out" | tail -8 | sed 's/^/       /'
  exit 1
fi
if [ "$svc" = "huangque-content" ]; then
  if out=$(cd "$wd" && PYTHONDONTWRITEBYTECODE=1 "$py_bin" -c "from content_domains import text; assert text.validate_copy_payload({'prompt':'ship-contract'})['prompt'] == 'ship-contract'" 2>&1); then
    echo "    ✓ $svc: 文案跨模块契约通过"
  else
    echo "    ❌ $svc: 文案跨模块契约失败 —— 中止，不重启"
    printf '%s\n' "$out" | tail -8 | sed 's/^/       /'
    exit 1
  fi
  if out=$(cd "$wd" && PYTHONDONTWRITEBYTECODE=1 "$py_bin" -c "import inspect; from content_domains import jobs_store, video; assert 'before_charge' in inspect.signature(jobs_store.create_paid_job).parameters; assert 'username' in inspect.signature(video.validate_xiaole_video_payload).parameters; assert callable(video.prepare_xiaole_reference_submission)" 2>&1); then
    echo "    ✓ $svc: Seedance 参考图跨模块契约通过"
  else
    echo "    ❌ $svc: Seedance 参考图跨模块契约失败 —— 中止，不重启"
    printf '%s\n' "$out" | tail -8 | sed 's/^/       /'
    exit 1
  fi
fi
RS
}

# 重启后置条件，两条一起断言：
#   1. 服务启动时间晚于本次 ship 开始重启的时刻 → 证明 restart 真的发生了（不是静默没动）
#   2. 没有任何 EnvironmentFile 比启动时间新   → 证明进程加载的是最新配置
# 第 2 条抓的正是这个坑：配置写在重启之后，值进了文件却没进进程，「看起来上线了、实际没生效」。
check_restart_effective(){
  $SSHC "$REMOTE" bash -s -- "$1" "$2" <<'RS'
set -u
svc="$1"; t0="$2"
ts=$(systemctl show -p ActiveEnterTimestamp --value "$svc" 2>/dev/null)
[ -n "$ts" ] || { echo "    ⏭ $svc 取不到启动时间，跳过校验"; exit 0; }
started=$(date -d "$ts" +%s 2>/dev/null) || { echo "    ⏭ $svc 启动时间无法解析，跳过校验"; exit 0; }

if [ "$started" -lt "$t0" ]; then
  echo "    ❌ $svc: 启动时间早于本次部署 —— restart 没有真的发生"
  exit 1
fi

stale=""
for f in $(systemctl show -p EnvironmentFiles --value "$svc" 2>/dev/null | tr ' ' '\n' | grep '^/'); do
  m=$(sudo stat -c %Y "$f" 2>/dev/null) || continue
  [ "$m" -gt "$started" ] && stale="$stale $f"
done
if [ -n "$stale" ]; then
  echo "    ❌ $svc: 以下 env 文件比进程启动时间还新，新配置没被加载：$stale"
  exit 1
fi
echo "    ✓ $svc 重启生效、配置已加载"
RS
}
for f in "$@"; do
  timer=""
  if [ "$NEED_CREATOR_AGENT_RELEASE" = "1" ]; then
    case "$f" in
      server/creator_agent_api.py|server/creator_agent/*.py|deploy/creator-agent-release.sh|deploy/requirements-creator-agent.txt|deploy/systemd/huangque-creator-agent.service|deploy/nginx-huangquechuanmei.conf)
        echo "  ✓ $f 已包含在 Creator Agent 发布闭包中"
        continue
        ;;
    esac
  fi
  case "$f" in
    site/assets/home/*)
      if [ -n "$HOME_ASSET_FILES" ]; then
        echo "  ✓ $f 已包含在首页依赖闭包中"
        continue
      fi
      ;;
  esac
  case "$f" in
    server/auth_server.py|server/hq_cli_api.py|server/director_workflow_contract.py|server/invites.py|server/invite_network.py|server/business_cards.py|server/wxpay.py|server/wechat_subscribe.py) dest=/home/ubuntu/auth-service/; svc=huangque-auth ;;
    server/content_domains/__init__.py|server/content_domains/cos.py|server/content_domains/miniprogram_security.py|server/content_domains/pricing.py)
             dest=/home/ubuntu/auth-service/content_domains/; svc=huangque-auth ;;
    server/content_domains/error_contract.py)
             dest=/home/ubuntu/auth-service/content_domains/; svc=huangque-auth ;;
    server/wechat_virtual_pay.py|server/sync_virtual_pay_goods.py)
             dest=/home/ubuntu/auth-service/; svc=huangque-auth ;;
    server/content_api.py) dest=/home/ubuntu/content-api/;  svc=huangque-content ;;
    server/func_names.py)  dest=/home/ubuntu/content-api/;  svc="huangque-content huangque-admin" ;;
    server/content_domains/function_registry.py)
             dest=/home/ubuntu/content-api/content_domains/
             if [ "$EXACT_CONTENT_DOMAINS" = "1" ]; then
               svc=huangque-admin
             else
               svc="huangque-content huangque-admin"
             fi
             ;;
    server/content_domains/feature_flags.py) dest=/home/ubuntu/auth-service/content_domains/; svc="huangque-auth huangque-content huangque-admin huangque-imggen-api huangque-leadgen-api" ;;
    server/content_domains/egress.py) dest=/home/ubuntu/content-api/content_domains/; svc="huangque-content huangque-admin huangque-imggen-api" ;;
    server/content_domains/browser_qa.py) dest=/home/ubuntu/content-api/content_domains/; svc=huangque-admin ;;
    server/content_domains/*) dest=/home/ubuntu/content-api/content_domains/;  svc=huangque-content ;;
    server/providers/*)
             rel="${f#server/providers/}"
             case "$rel" in */*) dest="/home/ubuntu/content-api/providers/${rel%/*}/" ;; *) dest=/home/ubuntu/content-api/providers/ ;; esac
             svc=huangque-content ;;
    tools/hq-cli/src/hq_cli/*)
             dest=/home/ubuntu/content-api/hq_cli/
             svc=huangque-content ;;
    server/admin_api.py)   dest=/home/ubuntu/content-api/;  svc=huangque-admin ;;
    server/qa_fixtures/*)  dest=/home/ubuntu/content-api/qa_fixtures/; svc=huangque-admin ;;
    server/leadgen_api.py) dest=/home/ubuntu/content-api/;  svc=huangque-leadgen-api ;;
    server/imggen_api.py)  dest=/home/ubuntu/content-api/;  svc=huangque-imggen-api ;;
    server/dl_service.py)  dest=/home/ubuntu/dl-service/;   svc=huangque-dl ;;
    server/tikhub.py)      dest=/home/ubuntu/content-api/;  svc="huangque-leadgen-api huangque-content huangque-imggen-api" ;;
    deploy/nginx-huangquechuanmei.conf) NGINX_RELOAD=1; add_deployed "$f"; echo "  ✓ $f → 已纳入 nginx 发布闭包（第 3.6 步安装/校验/reload）"; continue ;;
    scripts/smoke_cli_bridge.sh) dest=/home/ubuntu/; svc="" ;;
    scripts/hq_bitable_sync_server.py) dest=/home/ubuntu/; svc="" ;;
    scripts/process_invite_reward_claims.py) dest=/home/ubuntu/auth-service/; svc="" ;;
    scripts/drift_sentinel.py) dest=/home/ubuntu/hq-drift/; svc="" ;;
    # systemd 单元与 drop-in。原来不在映射表里，只能手工 scp + daemon-reload —— 漏一步就出事：
    # leadgen 曾因单元没加载 auth.env 而拿不到 HQ_INTERNAL_TOKEN，退点全部静默回退直写。
    deploy/systemd/*.service.d/*.conf)
             unit="${f#deploy/systemd/}"; unit="${unit%%.d/*}"        # huangque-xxx.service
             dest="/etc/systemd/system/${unit}.d/"
             svc="${unit%.service}"; NEED_RELOAD=1 ;;
    deploy/systemd/*.service)
             unit="$(basename "$f")"
             dest=/etc/systemd/system/
             case "$unit" in
               huangque-invite-reward-claims.service) svc="" ;;
               *) svc="${unit%.service}" ;;
             esac
             NEED_RELOAD=1 ;;
    deploy/systemd/*.timer)
             unit="$(basename "$f")"
             dest=/etc/systemd/system/
             svc=""; timer="$unit"; NEED_RELOAD=1 ;;
    deploy/systemd/*.example) echo "  ⏭ $f 只是示例，不部署"; continue ;;
    site/*)  rel="${f#site/}"
             case "$rel" in */*) dest="$WWW/${rel%/*}/" ;; *) dest="$WWW/" ;; esac
             svc="" ;;
    *) echo "  ⚠ 不认识 $f —— 不知道部署到哪，跳过（需要的话告诉我加进映射）"; continue ;;
  esac
  case "$dest" in /etc/systemd/system/*)
    $SSHC "$REMOTE" "sudo mkdir -p $dest" || { echo "  ❌ $dest 创建失败"; exit 1; } ;;
    /home/ubuntu/content-api/providers/*|/home/ubuntu/content-api/qa_fixtures/*)
    $SSHC "$REMOTE" "sudo mkdir -p $dest" || { echo "  ❌ $dest 创建失败"; exit 1; } ;;
    /home/ubuntu/content-api/hq_cli/*)
    $SSHC "$REMOTE" "sudo mkdir -p $dest" || { echo "  ❌ $dest 创建失败"; exit 1; } ;;
  esac
  if [ "$f" = "scripts/drift_sentinel.py" ]; then
    $SSHC "$REMOTE" "mkdir -p /home/ubuntu/hq-drift" || { echo "  ❌ hq-drift 目录创建失败"; exit 1; }
  fi
  if [ "$EXACT_CONTENT_DOMAINS" = "1" ]; then
    case "$f" in
      server/content_domains/*.py)
        domain_module="${f#server/content_domains/}"
        domain_module="${domain_module%.py}"
        case "$domain_module" in
          ''|*[!A-Za-z0-9_]*) echo "  ❌ content domain 模块名非法：$f"; exit 1 ;;
        esac
        EXACT_DOMAIN_MODULES="$EXACT_DOMAIN_MODULES $domain_module"
        ;;
    esac
  fi
  push_file "$f" "$dest" \
    && echo "  ✓ $f → $dest" || { echo "  ❌ $f 部署失败"; exit 1; }
  case "$f" in
    server/qa_fixtures/*)
      old_public="$WWW/workbench/assets/qa/$(basename "$f")"
      $SSHC "$REMOTE" "sudo rm -f '$old_public'" \
        && echo "  ✓ 已移除旧公开测试素材：$old_public" \
        || { echo "  ❌ 旧公开测试素材移除失败"; exit 1; }
      ;;
  esac
  if [ "$f" = "server/content_domains/pricing.py" ] || [ "$f" = "server/content_domains/error_contract.py" ] || [ "$f" = "server/content_domains/feature_flags.py" ]; then
    push_file "$f" /home/ubuntu/content-api/content_domains/ \
      && echo "  ✓ $f → /home/ubuntu/content-api/content_domains/" \
      || { echo "  ❌ $f 部署到 content 失败"; exit 1; }
    add_svc "huangque-content huangque-admin"
  fi
  add_deployed "$f"
  case "$f" in
    server/content_api.py|server/content_domains/*)
      if [ "$f" = "server/content_domains/pricing.py" ] || [ "$f" = "server/content_domains/error_contract.py" ] || [ "$f" = "server/content_domains/feature_flags.py" ]; then
        echo "  ✓ 共享模块已分别部署到 auth 与 content"
      elif [ "$EXACT_CONTENT_DOMAINS" = "1" ] && [ "$f" != "server/content_api.py" ]; then
        echo "  ✓ file-only 模式：$f 不触发 content_domains 整目录同步"
      elif [ "$CONTENT_DOMAINS_SYNCED" = "0" ] && [ -d server/content_domains ]; then
        CONTENT_DOMAIN_FILES="$(git ls-files server/content_domains)" \
          || { echo "  ❌ 无法读取 content_domains Git 文件清单"; exit 1; }
        [ -n "$CONTENT_DOMAIN_FILES" ] \
          || { echo "  ❌ content_domains Git 文件清单为空"; exit 1; }
        $SSHC "$REMOTE" "sudo mkdir -p /home/ubuntu/content-api/content_domains" || { echo "  ❌ content_domains 目录创建失败"; exit 1; }
        push_dir server/content_domains/ /home/ubuntu/content-api/content_domains/ \
          && echo "  ✓ server/content_domains/ → /home/ubuntu/content-api/content_domains/（整目录同步）" \
          || { echo "  ❌ content_domains 整目录部署失败"; exit 1; }
        for tracked in $CONTENT_DOMAIN_FILES; do add_deployed "$tracked"; done
        CONTENT_DOMAINS_SYNCED=1
      fi
      ;;
  esac
  # content_api 与视频 Agent 会通过 python -m hq_cli 调用工具。生产目录不是
  # 完整 checkout，发布任一桥接依赖时必须同步整个可导入包，避免只上线调用方。
  case "$f" in
    server/content_api.py|server/content_domains/video_agent.py|server/content_domains/video_agent_tools.py|server/content_domains/hq_cli_executor.py|tools/hq-cli/src/hq_cli/*)
      if [ "$HQ_CLI_SYNCED" = "0" ]; then
        HQ_CLI_FILES="$(git ls-files tools/hq-cli/src/hq_cli)" \
          || { echo "  ❌ 无法读取 hq_cli Git 文件清单"; exit 1; }
        [ -n "$HQ_CLI_FILES" ] \
          || { echo "  ❌ hq_cli Git 文件清单为空"; exit 1; }
        $SSHC "$REMOTE" "sudo mkdir -p /home/ubuntu/content-api/hq_cli" \
          || { echo "  ❌ hq_cli 目录创建失败"; exit 1; }
        push_dir tools/hq-cli/src/hq_cli/ /home/ubuntu/content-api/hq_cli/ \
          && echo "  ✓ tools/hq-cli/src/hq_cli/ → /home/ubuntu/content-api/hq_cli/（依赖闭包同步）" \
          || { echo "  ❌ hq_cli 依赖闭包部署失败"; exit 1; }
        for tracked in $HQ_CLI_FILES; do add_deployed "$tracked"; done
        HQ_CLI_SYNCED=1
      fi
      ;;
  esac
  case "$f" in
    server/providers/*|server/content_api.py|server/content_domains/*)
      if [ "$PROVIDERS_SYNCED" = "0" ] && { [ "$EXACT_CONTENT_DOMAINS" = "0" ] || [ "${f#server/providers/}" != "$f" ]; }; then
        PROVIDER_FILES="$(git ls-files server/providers)" \
          || { echo "❌ 无法读取 providers Git 文件清单"; exit 1; }
        [ -n "$PROVIDER_FILES" ] \
          || { echo "❌ providers Git 文件清单为空"; exit 1; }
        $SSHC "$REMOTE" "sudo mkdir -p /home/ubuntu/content-api/providers" || { echo "  ❌ providers 目录创建失败"; exit 1; }
        push_dir server/providers/ /home/ubuntu/content-api/providers/ \
          && echo "  ✓ server/providers/ → /home/ubuntu/content-api/providers/（依赖闭包同步）" \
          || { echo "  ❌ providers 依赖闭包部署失败"; exit 1; }
        for tracked in $PROVIDER_FILES; do add_deployed "$tracked"; done
        PROVIDERS_SYNCED=1
      fi
      ;;
  esac
  add_svc "$svc"
  add_timer "$timer"
done

# 视频 Agent 桥接链路文件：同批发布时必须补冒烟脚本，并在提供凭证时跑真实链路冒烟。
case " $DEPLOYED " in
  *" server/auth_server.py "*|*" server/hq_cli_api.py "*|*" server/content_api.py "*|\
  *" server/content_domains/video_agent.py "*|*" server/content_domains/video_agent_tools.py "*|\
  *" server/content_domains/hq_cli_executor.py "*|*" server/content_domains/cli_uploads.py "*|\
  *" tools/hq-cli/src/hq_cli/"*)
    BRIDGE_DEPLOYED=1
    ;;
esac
if [ -n "$BRIDGE_DEPLOYED" ]; then
  push_file scripts/smoke_cli_bridge.sh /home/ubuntu/ \
    && echo "  ✓ scripts/smoke_cli_bridge.sh → /home/ubuntu/（链路冒烟脚本随桥接发布同步）" \
    || { echo "  ❌ 冒烟脚本部署失败"; exit 1; }
  add_deployed "scripts/smoke_cli_bridge.sh"
fi

if [ "$HQ_CLI_SYNCED" = "1" ]; then
  echo "==> 3.3/5 黄雀 CLI 部署冒烟"
  $SSHC "$REMOTE" bash -s -- "$CONTENT_PYTHON" <<'RS' || exit 1
set -u
py_bin="$1"
cd /home/ubuntu/content-api
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/home/ubuntu/content-api \
  "$py_bin" -m hq_cli version --json >/dev/null
RS
  echo "  ✓ python -m hq_cli version --json 通过"
fi

# exact 模式不会同步依赖目录，因此逐个导入明确点名的模块，避免首次客户请求才暴露缺依赖。
if [ -n "$EXACT_DOMAIN_MODULES" ]; then
  echo "==> 3.4/5 file-only 内容模块 import 冒烟"
  for domain_module in $EXACT_DOMAIN_MODULES; do
    $SSHC "$REMOTE" bash -s -- "$domain_module" "$CONTENT_PYTHON" <<'RS' || exit 1
set -u
module="$1"; py_bin="$2"
case "$module" in ''|*[!A-Za-z0-9_]*) exit 2;; esac
cd /home/ubuntu/content-api
PYTHONDONTWRITEBYTECODE=1 "$py_bin" -c "from content_domains import $module"
RS
    echo "  ✓ content_domains.$domain_module import 通过"
  done
fi

# 代码已同步但旧进程仍在运行。先对每个待重启服务做纯 import 冒烟，
# 把缺模块/坏引用挡在 restart 前，避免把可用服务重启成崩溃循环。
# 入口从 systemd ExecStart 反查（见 smoke_import），覆盖全部服务而非只有 content。
if [ -n "$RESTART" ]; then
  echo "==> 3.5/5 import 冒烟（每个待重启服务）"
  for s in $RESTART; do smoke_import "$s" || exit 1; done
fi

# nginx 配置闭包：备份 → 安装 → nginx -t 门禁 → reload；校验失败恢复备份，
# 运行中的 nginx 不受影响。专用上传限额/限速只有走这个闭包才会真正生效。
if [ "$NGINX_RELOAD" = "1" ]; then
  echo "==> 3.6/5 nginx 配置闭包"
  if command -v rsync >/dev/null 2>&1; then
    rsync -az --rsync-path="sudo rsync" -e "$SSHC" \
      deploy/nginx-huangquechuanmei.conf "$REMOTE:/tmp/huangquechuanmei.conf" \
      || { echo "  ❌ nginx 配置上传失败"; exit 1; }
  else
    scp -q $SSH_OPTS deploy/nginx-huangquechuanmei.conf "$REMOTE:/tmp/huangquechuanmei.conf" \
      || { echo "  ❌ nginx 配置上传失败"; exit 1; }
  fi
  if $SSHC "$REMOTE" "sudo install -m 0644 /etc/nginx/sites-available/huangquechuanmei /etc/nginx/sites-available/huangquechuanmei.rollback && \
      sudo install -m 0644 /tmp/huangquechuanmei.conf /etc/nginx/sites-available/huangquechuanmei && rm -f /tmp/huangquechuanmei.conf && \
      sudo nginx -t"; then
    $SSHC "$REMOTE" "sudo systemctl reload nginx" \
      || { echo "  ❌ nginx reload 失败"; exit 1; }
    echo "  ✓ nginx -t 通过并 reload"
  else
    $SSHC "$REMOTE" "sudo install -m 0644 /etc/nginx/sites-available/huangquechuanmei.rollback /etc/nginx/sites-available/huangquechuanmei; sudo nginx -t" \
      || true
    echo "  ❌ nginx 配置校验失败，已恢复备份并中止发布"
    exit 1
  fi
fi

# 4. 重启受影响的后端服务（纯前端则跳过）
if [ "$NEED_RELOAD" = "1" ]; then
  echo "==> 4/5 systemd 单元有改动，先 daemon-reload"
  $SSHC "$REMOTE" "sudo systemctl daemon-reload" || { echo "  ❌ daemon-reload 失败"; exit 1; }
fi
if [ -n "$RESTART" ]; then
  echo "==> 4/5 重启服务:$RESTART"
  # 视频 Agent 的委托端点 (/api/auth/internal/cli/delegate) 与报价核验端点
  # (/api/auth/internal/cli/quote-claims) 都在鉴权服务上：同一批发布必须
  # 先重启并验证 auth，再重启 content，否则内容服务会在鉴权侧 404/403。
  if printf ' %s ' "$RESTART" | grep -q ' huangque-auth '; then
    echo "  → 先重启并验证 huangque-auth（视频 Agent 委托端点依赖）"
    T0_AUTH=$($SSHC "$REMOTE" "date +%s") || { echo "  ❌ 取服务器时间失败"; exit 1; }
    $SSHC "$REMOTE" "sudo systemctl restart huangque-auth" || { echo "  ❌ huangque-auth 重启失败"; exit 1; }
    wait_for_services huangque-auth || exit 1
    check_restart_effective huangque-auth "$T0_AUTH" || exit 1
    RESTART=$(printf '%s\n' $RESTART | grep -v '^huangque-auth$' | tr '\n' ' ' | sed 's/ *$//')
  fi
  if [ -n "$RESTART" ]; then
    # 取「服务器」时间做基准（ActiveEnterTimestamp 是服务器时钟，用本地时间会因时差误判）
    T0=$($SSHC "$REMOTE" "date +%s") || { echo "  ❌ 取服务器时间失败"; exit 1; }
    $SSHC "$REMOTE" "sudo systemctl restart $RESTART" || { echo "  ❌ 重启失败"; exit 1; }
    wait_for_services || exit 1
    echo "  校验重启真的生效、配置已加载"
    for s in $RESTART; do check_restart_effective "$s" "$T0" || exit 1; done
  fi
else
  [ -n "$TIMERS" ] || echo "==> 4/5 纯前端，无需重启"
fi
if [ -n "$TIMERS" ]; then
  echo "==> 4/5 启用并刷新定时器:$TIMERS"
  $SSHC "$REMOTE" "sudo systemctl enable --now $TIMERS && sudo systemctl restart $TIMERS" \
    || { echo "  ❌ 定时器启用失败"; show_service_diagnostics "$TIMERS"; exit 1; }
  for t in $TIMERS; do
    $SSHC "$REMOTE" "systemctl is-enabled --quiet '$t' && systemctl is-active --quiet '$t'" \
      || { echo "  ❌ $t 未进入 enabled/active"; show_service_diagnostics "$t"; exit 1; }
    echo "  ✓ $t enabled/active"
  done
fi

# 部署后校验：只校验本次 ship 实际推送的文件线上 == git origin/main。
if [ -n "$DEPLOYED" ]; then
  $SSHC "$REMOTE" "test -f /home/ubuntu/hq-drift/drift_sentinel.py && python3 /home/ubuntu/hq-drift/drift_sentinel.py --verify-deploy $DEPLOYED" \
    && echo "  ✓ 部署后漂移校验通过" || { echo "  ❌ 部署后漂移校验失败"; exit 1; }
  $SSHC "$REMOTE" "python3 /home/ubuntu/hq-drift/drift_sentinel.py --bless-deploy $DEPLOYED" >/dev/null 2>&1 \
    && echo "  ✓ 本次部署文件已记录" || echo "  （跳过部署记录：哨兵未安装）"
fi

# 服务器 checkout 只作为 git 镜像，不允许在服务器上直接提交热改。
$SSHC "$REMOTE" 'if [ -d /home/ubuntu/huangque-main-site/.git ]; then
  cd /home/ubuntu/huangque-main-site &&
  mkdir -p .githooks-readonly &&
  cat > .githooks-readonly/pre-commit <<'"'"'EOF'"'"'
#!/usr/bin/env bash
echo "禁止在服务器 checkout 直接提交。请在本地分支开 PR，合并后用 ./ship 部署。" >&2
exit 1
EOF
  chmod +x .githooks-readonly/pre-commit &&
  git config core.hooksPath .githooks-readonly
fi' >/dev/null 2>&1 && echo "  ✓ 服务器 checkout 提交保护已安装" || echo "  （跳过 checkout 提交保护）"

# 5. 验证 + 给回滚命令
echo "==> 5/5 验证"
if ! HEALTH_CODE=$(curl -sS -o /dev/null -w "%{http_code}" "$HEALTH_URL" --max-time 10); then
  echo "  ❌ 健康检查请求失败: ${HEALTH_URL} (HTTP ${HEALTH_CODE:-000})"
  show_service_diagnostics
  exit 1
fi
case "$HEALTH_CODE" in
  2??) echo "  ✓ 健康检查: HTTP $HEALTH_CODE" ;;
  *)
    echo "  ❌ 健康检查未通过: HTTP $HEALTH_CODE ($HEALTH_URL)"
    show_service_diagnostics
    exit 1
    ;;
esac

# 真实链路冒烟：内容服务 → 临时委托 → 无扣点 CLI 读取 → 自动撤销。
# 仅在发布涉及视频 Agent 桥接且显式提供凭证时执行；凭证经 stdin 传远端。
if [ -n "$BRIDGE_DEPLOYED" ]; then
  echo "==> 5.5/5 视频 Agent 真实链路冒烟"
  if [ -n "${HQ_SMOKE_USERNAME:-}" ] && [ -n "${HQ_SMOKE_WEB_TOKEN:-}" ]; then
    printf 'HQ_SMOKE_USERNAME=%s\nHQ_SMOKE_WEB_TOKEN=%s\n' \
      "$HQ_SMOKE_USERNAME" "$HQ_SMOKE_WEB_TOKEN" \
      | $SSHC "$REMOTE" "umask 077; cat > /tmp/hq-smoke.env"
    if $SSHC "$REMOTE" "trap 'rm -f /tmp/hq-smoke.env' EXIT; sudo bash /home/ubuntu/smoke_cli_bridge.sh /tmp/hq-smoke.env"; then
      echo "  ✓ 临时委托 → 无扣点 CLI 读取 → 撤销 通过"
    else
      echo "  ❌ 视频 Agent 链路冒烟失败（委托端点/CLI 运行包可能未生效）"
      exit 1
    fi
  else
    echo "  ⏭ 未提供 HQ_SMOKE_USERNAME / HQ_SMOKE_WEB_TOKEN，跳过真实链路冒烟（通用 health 不能证明这条链路）"
  fi
fi

SHA=$(git rev-parse --short HEAD)
echo "✅ 上线完成 | 本次提交 $SHA"
echo "   ↩ 要回滚这次：为 $SHA 创建 revert PR，合并到 main 后再用 ship 发布同一文件清单"
