# Copy variable names to /home/ubuntu/.secrets/hermes-openai.env (mode 600).
OPENAI_API_BASE=
OPENAI_API_KEY=
HERMES_MODEL=gpt-4o

# Required for the one-time pre-isolation artifact migration. Confirm this
# existing username in the account service; never guess or auto-select it.
HERMES_LEGACY_OWNER=
HERMES_DATA_QUOTA_MB=2048

# Account that runs this release script and owns the private backup tree.
HERMES_DEPLOY_USER=ubuntu
HERMES_DEPLOY_GROUP=ubuntu

# Optional provider fallbacks.
HERMES_ZELONG_API_BASE=
HERMES_ZELONG_API_KEY=
HERMES_ZELONG_MINI_MODEL=
HERMES_ZELONG_MODEL=
HERMES_GPTSAPI_BASE=
HERMES_GPTSAPI_KEY=
HERMES_GPTSAPI_MODEL=

# Optional media tools.
ARK_API_KEY=
SEEDANCE_API_KEY=
DASHSCOPE_API_KEY=
PEXELS_API_KEY=
HERMES_GOOGLE_API_KEY=
HERMES_GOOGLE_CX=
HERMES_VISION_API_KEY=

# Preserve the complete original route set. Set to 0 only for a restricted deployment.
HERMES_ENABLE_INTERNAL_TOOLS=1
