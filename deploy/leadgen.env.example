# 抖音获客服务（leadgen-A / leadgen-B）的密钥。
# 部署时复制到服务器 /etc/huangque/leadgen.env，填入真实值，权限设 600：
#   sudo install -m 600 /dev/null /etc/huangque/leadgen.env && sudo nano /etc/huangque/leadgen.env
# 此文件（.example）只是模板，真实值永不进 git。

# 团队成员提交获客任务的共享口令（人工输入）
LEADGEN_PASSWORD=change-me

# worker 领取任务的内部令牌（机器用，建议随机长串）
LEADGEN_WORKER_TOKEN=change-me
