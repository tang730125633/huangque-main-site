# 抖音获客服务（leadgen-A / leadgen-B）等所用的服务器密钥。
# 真实文件在服务器：/etc/leadgen-secrets.env（root，权限 600，永不进 git），
# 由各 systemd 单元 EnvironmentFile= 引用。此 .example 只是模板。
#
# 追加/修改后需 restart 相关服务生效：
#   sudo systemctl restart leadgen-A leadgen-B

# 团队成员提交获客任务的共享口令（人工输入；轮换后需通知团队）
LEADGEN_PASSWORD=change-me

# worker 领取任务的内部令牌（机器用；轮换后需同步 Mac worker 的 env，否则爬取中断）
LEADGEN_WORKER_TOKEN=change-me

# TikHub API key（视频号/抖音解析）
TIKHUB_KEY=change-me
