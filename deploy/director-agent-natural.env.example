# Optional Director model settings; never put real keys in this repository.
# Runtime file: /home/ubuntu/content-api/content.env (protected EnvironmentFile).
# Set this pair together. A custom base without a dedicated key fails closed.
# DIRECTOR_AGENT_API_BASE=https://api.deepseek.com
# DIRECTOR_AGENT_API_KEY=<set-only-in-protected-runtime-environment>
# DIRECTOR_AGENT_MODEL=deepseek-v4-flash
# auto: deepseek* uses native Chat Completions; other models retain Responses.
DIRECTOR_AGENT_API_PROTOCOL=auto
# Explicit values: auto | responses | chat_completions
# Do not infer a key, enable a feature flag, or change any running service
# merely by copying this example. Existing server model config remains intact.
