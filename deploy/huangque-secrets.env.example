# Huangque split secret EnvironmentFile templates.
# Copy only the needed section into the matching server-local file.
# Real files stay on the server, are never committed, and should be owned by root with 0600 permissions.
#
# Suggested target files:
#   /etc/huangque/auth.env
#   /etc/huangque/content-core.env
#   /etc/huangque/providers-openai.env
#   /etc/huangque/providers-cosyvoice.env
#   /etc/huangque/providers-heygen.env
#   /etc/huangque/providers-cos.env
#   /etc/huangque/imggen.env
#   /etc/huangque/leadgen.env

### /etc/huangque/auth.env
HQ_INTERNAL_TOKEN=replace-with-random-internal-token
HQ_AUTH_TOKEN_TTL=2592000
HQ_AUTH_FAIL_WINDOW=300
HQ_AUTH_FAIL_MAX=5
HQ_AUTH_REGISTER_WINDOW=120
HQ_AUTH_REGISTER_MAX=10
HQ_AUTH_REGISTER_IP_WINDOW=60
HQ_AUTH_REGISTER_IP_MAX=20
# 会员强校验上线开关：默认必须为 0。完成显式名单迁移和核对后才改为 1。
HQ_MEMBERSHIP_ENFORCEMENT_ENABLED=0
# 微信支付(auth_server 的 /api/auth/wxpay/* 用;公钥模式)。值不写这里,配到服务器实际
# env 文件。私钥/证书/公钥/APIv3密钥已放 /home/ubuntu/.wxpay/(600权限),此处仅指路径。
WX_PAY_MCH_ID=1111592799
WX_PAY_MCH_CERT_SERIAL_NO=replace-with-cert-serial
WX_PAY_PRIVATE_KEY_PATH=/home/ubuntu/.wxpay/apiclient_key.pem
WX_PAY_API_V3_KEY=replace-with-32-byte-apiv3-key
WX_PAY_PUBLIC_KEY_PATH=/home/ubuntu/.wxpay/wxpay_public_key.pem
WX_PAY_PUBLIC_KEY_ID=replace-with-public-key-id
WX_PAY_APPID=replace-with-appid-bound-to-mchid
WX_PAY_NOTIFY_URL=https://huangquechuanmei.com/api/auth/wxpay/notify
# 小程序登录态（AppSecret 仅保存在服务器）
WX_MP_APPID=wx-your-miniprogram-appid
WX_MP_APPSECRET=replace-with-miniprogram-appsecret
# 微信小程序作品完成订阅模板；字段固定 thing1/date2/thing3，跳转 pages/assets/assets。
WX_SUBSCRIBE_WORK_COMPLETE_TEMPLATE_ID=replace-with-work-complete-template-id
# 公告模板字段：thing1=标题、date2=发布时间、thing3=内容摘要
WX_SUBSCRIBE_ANNOUNCEMENT_TEMPLATE_ID=replace-with-announcement-template-id
WX_SUBSCRIBE_MINIPROGRAM_STATE=formal
# 小程序支付总闸：0 临时关闭所有新下单；历史订单确认、回调和退款仍继续处理。
HQ_MINIPROGRAM_PAYMENTS_ENABLED=1
# 微信小程序官方虚拟支付：0=现网，1=沙箱
WX_VIRTUAL_PAY_ENV=0
WX_VIRTUAL_PAY_OFFER_ID=replace-with-offer-id
WX_VIRTUAL_PAY_APP_KEY_PROD=replace-with-production-app-key
WX_VIRTUAL_PAY_APP_KEY_SANDBOX=replace-with-sandbox-app-key
# product_id 必须与“虚拟支付”后台已上传并发布的商品 ID、价格完全一致。
WX_VIRTUAL_PAY_PRODUCTS_JSON=[{"id":"points_1000","product_id":"hq_points_1000","title":"1000 点","price_fen":9900,"points":1000},{"id":"points_2000","product_id":"hq_points_2000","title":"2000 点","price_fen":19900,"points":2000},{"id":"points_5000","product_id":"hq_points_5000","title":"5000 点","price_fen":49900,"points":5000,"recommended":true}]

### /etc/huangque/content-core.env
CONTENT_API_PORT=8096
AUTH_BASE=http://127.0.0.1:8095
CONTENT_OUT=/home/ubuntu/content-api/content_out
FEATURE_FLAGS_DB=/home/ubuntu/content-api/feature_flags.db
VERIFY_CACHE_TTL=8
VERIFY_CACHE_MAX=2048
# 32-byte random value encoded with URL-safe base64; shared by admin/content.
HQ_PROVIDER_KEYS_MASTER_KEY=replace-with-base64url-32-byte-key
# Seedance 480p + WaveSpeed SeedVR2；生产默认关闭，仅在获批环境显式开启。
SEEDANCE_UPSCALE_ENABLED=0
# D-6 完成确认灰度开关。迁移 dry-run/apply/verify 全部通过前必须保持 0。
HQ_SHORT_DRAMA_COMPLETION_ENABLED=0
HTTPS_PROXY=
HTTP_PROXY=

### /etc/huangque/providers-openai.env
OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE=https://api.openai.com
XAI_API_KEY=replace-with-xai-key
XAI_API_BASE=https://api.x.ai/v1
# Grok video fallback. Used only after a definite xAI pre-creation auth/billing failure.
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_MAX_CONCURRENCY=2
COPY_MODEL=gpt-4o
TTS_MODEL=gpt-4o-mini-tts
# 编导页面 format=script 与 breakdown 视觉分析。
# 生产 huangque-content 由 systemd 注入 /home/ubuntu/content-api/content.env；
# 上线前把下面两项写入该服务器本地文件（0600），不要提交真实密钥。
REVERSE_ZHIPU_KEY=replace-with-zhipu-api-key
REVERSE_ZHIPU_MODEL=glm-4v-plus

### /etc/huangque/providers-cosyvoice.env
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
COSY_CLONE_MODEL=cosyvoice-v3.5-plus
COSY_PRESET_MODEL=cosyvoice-v1
COSY_CLONE_PREFIX=hq

### /etc/huangque/providers-heygen.env
HEYGEN_API_KEY=replace-with-heygen-key
HEYGEN_API_BASE=https://api.heygen.com/v3
HEYGEN_POLL_INTERVAL=8
HEYGEN_TIMEOUT=1200

### /etc/huangque/providers-cos.env
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=replace-with-bucket-name
COS_PREFIX=huangque
COS_DOMAIN=
COS_PUBLIC=1
COS_SIGN_EXPIRE=604800
COS_DELETE_LOCAL=0
COS_COLLECT=1

### /etc/huangque/imggen.env
IMGGEN_API_PORT=8101
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_BASE=https://generativelanguage.googleapis.com
REVERSE_MODEL=gemini-2.5-flash
REVERSE_COST=2
REVERSE_MAX_CONCURRENCY=2
ZELONG_KEY=replace-with-zelong-key
ZELONG_BASE=https://api.xiaoleai.team
ZELONG2_KEY=replace-with-zelong2-key
ZELONG2_BASE=https://api.zelong.vip/image-pool
# Optional zelong2 failover pool. Comma or semicolon separated.
# ZELONG2_KEY is still used as the first account when present.
ZELONG2_KEYS=replace-with-backup-zelong2-key-1,replace-with-backup-zelong2-key-2
ZELONG2_BASES=https://api.zelong.vip/image-pool,https://backup.example.com/image-pool

### /etc/huangque/leadgen.env
LEADGEN_API_PORT=8100
AUTH_DB=/home/ubuntu/auth-service/users.db
CONTENT_JOB_DB=/home/ubuntu/content-api/content_jobs.db
TIKHUB_KEY=replace-with-tikhub-key
TIKHUB_BASE=https://api.tikhub.io
WXCH_DECRYPT_API=http://127.0.0.1:3001/api/decrypt

### /etc/leadgen-secrets.env
LEADGEN_PASSWORD=replace-with-team-submit-password
LEADGEN_WORKER_TOKEN=replace-with-worker-token
XIAOTAN_API=http://127.0.0.1:8501
ADMIN_PASSWORD=replace-with-admin-password
NUMBER_POOL=/home/ubuntu/number_pool
LEADGEN_USER_HOME=/home/ubuntu
MAX_WORKERS=6
MC_VENV_PY=/home/ubuntu/MediaCrawler/.venv/bin/python
POOL_HEALTH_PY=/home/ubuntu/content-api/pool_health.py
