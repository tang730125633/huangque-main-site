[Unit]
Description=Huangque independent Creator Agent API
After=network-online.target huangque-auth.service
Wants=network-online.target
Requires=huangque-auth.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/huangque/creator-agent/current
EnvironmentFile=-/home/ubuntu/auth-service/auth.env
EnvironmentFile=-/etc/huangque/creator-agent.env
Environment=PYTHONUNBUFFERED=1
Environment=CREATOR_AGENT_DB=/var/lib/huangque-creator-agent/creator_agent.db
ExecStart=/opt/huangque/creator-agent/current/.venv/bin/python /opt/huangque/creator-agent/current/creator_agent_api.py --host 127.0.0.1 --port 8114
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StateDirectory=huangque-creator-agent
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huangque-creator-agent
MemoryHigh=600M
MemoryMax=900M
TasksMax=128

[Install]
WantedBy=multi-user.target
