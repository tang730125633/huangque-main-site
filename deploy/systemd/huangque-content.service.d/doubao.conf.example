# huangque-content 的豆包 TTS / 声音克隆配置
# 落地：/etc/systemd/system/huangque-content.service.d/doubao.conf
# 部署后：sudo systemctl daemon-reload && sudo systemctl restart huangque-content
#
# ⚠ 只入库这份 .example。真值永远不进 git。
#
# 现状与建议（2026-07-09 巡检）
# ────────────────────────────────
# 线上这个 drop-in 里写的是【明文】Environment=，而且曾经是 644 —— ubuntu 用户无需 sudo
# 就能读到 DOUBAO_TOKEN。已临时收紧为 600。
#
# 但更彻底的做法是【直接删掉这个 drop-in】：这 5 个变量在
# /home/ubuntu/content-api/content.env（600）里已经有一份完全相同的值（逐个比对过哈希）。
# 主单元的 EnvironmentFile 已经加载了 content.env，drop-in 的 Environment= 只是把同样的值
# 又覆盖了一遍，删掉对运行结果没有任何影响。
#
#     sudo rm /etc/systemd/system/huangque-content.service.d/doubao.conf
#     sudo systemctl daemon-reload && sudo systemctl restart huangque-content
#     # 验证：进程仍拿得到 DOUBAO_TOKEN（来自 content.env）
#     sudo tr '\0' '\n' < /proc/$(pgrep -f content_api.py | head -1)/environ | grep -c '^DOUBAO_TOKEN='
#
# 需要重启 content，会打断在飞的作图/视频任务，挑低峰时段做。
#
# 若坚持保留 drop-in 形式，请确保 chmod 600 且值与 content.env 一致。

[Service]
Environment="DOUBAO_APPID=<从 content.env 取>"
Environment="DOUBAO_TOKEN=<从 content.env 取>"
Environment="DOUBAO_CLONE_RESOURCE=volc.megatts.voiceclone"
Environment="DOUBAO_CLONE_MODEL_TYPE=4"
Environment="DOUBAO_TTS_RESOURCE=seed-icl-2.0"
