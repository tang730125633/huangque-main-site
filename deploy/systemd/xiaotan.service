[Unit]
Description=XiaoTan (Douyin Scraper API) for Dapeng AI
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/douyin-scraper
ExecStart=/home/ubuntu/douyin-scraper/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8501 --log-level info
Restart=on-failure
RestartSec=5
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xiaotan

[Install]
WantedBy=multi-user.target
