[Unit]
Description=Huangque Test Authentication Service
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/huangque-test-server/server
EnvironmentFile=/etc/huangque-test/test.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/huangque-test-server/server/auth_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
