[Unit]
Description=Huangque Test Admin API
After=network.target huangque-test-auth.service
Requires=huangque-test-auth.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/huangque-test-server/server
EnvironmentFile=/etc/huangque-test/test.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/huangque-test-server/server/admin_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
