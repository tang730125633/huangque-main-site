[Unit]
Description=Huangque Test Shared Xray Egress
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=admin
Group=admin
ExecStart=/usr/local/bin/xray-egress run -c /etc/huangque-test/egress/xray-client.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
