[Unit]
Description=Huangque IP12 Agent preview on zelong
After=network.target huangque-auth.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hermes-preview
ExecStart=/bin/bash /home/ubuntu/hermes-preview/run-preview.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
