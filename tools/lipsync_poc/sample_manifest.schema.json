{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huangque.local/schemas/lipsync-poc-manifest-v1.json",
  "title": "Short Drama Lip-sync PoC Sample Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "dataset_name", "samples"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "dataset_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "video_file",
          "audio_file",
          "transcript",
          "speaking_mode",
          "duration_ms",
          "ratio",
          "output_spec"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "video_file": {"type": "string", "minLength": 1},
          "audio_file": {"type": "string", "minLength": 1},
          "transcript": {"type": "string", "minLength": 1},
          "speaking_mode": {
            "enum": ["visible", "offscreen", "narration"]
          },
          "character_key": {"type": ["string", "null"]},
          "face_target": {"type": ["object", "null"]},
          "duration_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          },
          "ratio": {"enum": ["9:16", "16:9", "1:1"]},
          "output_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resolution", "fps"],
            "properties": {
              "resolution": {"enum": ["720p", "1080p"]},
              "fps": {"enum": [24, 25, 30]}
            }
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
