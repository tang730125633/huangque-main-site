{
  "openapi": "3.0.3",
  "info": {
    "title": "黄雀 AI · 后端接口总表",
    "version": "2.0.0",
    "description": "黄雀主站全部自有后端接口(认证/作图/文案/配音/视频/采集获客/下载/任务)。\n\n**认证**:除登录和健康检查外,均需 `Authorization: Bearer <token>`(登录拿)。点右上 Authorize 填 token 即可 Try it。\n\n**异步任务**:作图/文案/配音/视频/采集/获客 都返回 `job_id`,再轮询 `GET /api/gen/job/{id}` 取结果。\n\n**点数**:生成类接口预扣点数(见各接口说明),任务失败自动退点;点数不足返回 402。\n\n外部 TikHub 接口见另一份 spec(右上切换)。"
  },
  "servers": [
    {
      "url": "https://huangquechuanmei.com",
      "description": "线上(nginx 按路径路由到各后端)"
    }
  ],
  "tags": [
    {
      "name": "认证",
      "description": "登录 / 用户信息 / 点数(auth 8095)"
    },
    {
      "name": "作图",
      "description": "黄雀引擎 + 纳米香蕉（content 8096 / imggen 8101）"
    },
    {
      "name": "文案",
      "description": "AI 文案 / 分镜脚本(content 8096)"
    },
    {
      "name": "配音音色",
      "description": "TTS 配音 + 个人音色克隆(content 8096)"
    },
    {
      "name": "视频",
      "description": "HeyGen 数字人视频(content 8096)"
    },
    {
      "name": "采集获客",
      "description": "内容爬取 + 关键词获客(leadgen 8100)"
    },
    {
      "name": "下载",
      "description": "无水印视频下载(dl 8097)"
    },
    {
      "name": "任务/历史/文件",
      "description": "异步任务轮询、生成历史、文件下载"
    },
    {
      "name": "健康",
      "description": "各服务健康检查"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "登录 /api/auth/login 拿到的 token"
      }
    },
    "schemas": {
      "ShortDramaAssemblyBlocker": {"type":"object","required":["code","message"],"additionalProperties":false,"properties":{"code":{"type":"string","enum":["missing_locked_voice_shot","missing_locked_video_shot","active_composition_job","preview_missing","final_missing"]},"message":{"type":"string"},"shot_id":{"type":"string"}}},
      "ShortDramaAssemblyShot": {"type":"object","required":["id","shot_key","sort_order","duration","voice","video","ready","blockers"],"additionalProperties":false,"properties":{"id":{"type":"string"},"shot_key":{"type":"string"},"sort_order":{"type":"integer","minimum":0},"duration":{"type":"integer","enum":[5,10]},"voice":{"type":"object","required":["locked","status"],"additionalProperties":false,"properties":{"locked":{"type":"boolean"},"status":{"type":"string","enum":["ready","blocked"]}}},"video":{"type":"object","required":["confirmed","status","current_version"],"additionalProperties":false,"properties":{"confirmed":{"type":"boolean"},"status":{"type":"string","enum":["pending_c3"]},"current_version":{"type":"integer","minimum":1,"nullable":true}}},"ready":{"type":"boolean"},"blockers":{"type":"array","items":{"$ref":"#/components/schemas/ShortDramaAssemblyBlocker"}}}},
      "ShortDramaAssemblyWorkspace": {"type":"object","required":["project_id","revision","stage","ratio","target_duration","assembly_revision","config","current_preview_version","current_final_version","preview_locked","implementation_status","rendering_enabled","shots","versions","active_job","readiness","actions","blockers"],"additionalProperties":false,"properties":{"project_id":{"type":"string"},"revision":{"type":"integer","minimum":1},"stage":{"type":"string","enum":["assembly_review","completed"]},"ratio":{"type":"string","enum":["9:16","16:9"]},"target_duration":{"type":"integer","enum":[30,45,60]},"assembly_revision":{"type":"integer","minimum":1},"config":{"type":"object","required":["subtitle","bgm","profiles"],"additionalProperties":false,"properties":{"subtitle":{"type":"object","required":["enabled","preset","position"],"additionalProperties":false,"properties":{"enabled":{"type":"boolean"},"preset":{"type":"string","enum":["white_outline"]},"position":{"type":"string","enum":["bottom","top"]}}},"bgm":{"type":"object","required":["asset_id","volume","fade_in_ms","fade_out_ms"],"additionalProperties":false,"properties":{"asset_id":{"type":"string","nullable":true},"volume":{"type":"number","minimum":0,"maximum":1},"fade_in_ms":{"type":"integer","minimum":0},"fade_out_ms":{"type":"integer","minimum":0}}},"profiles":{"type":"object","required":["preview","final"],"additionalProperties":false,"properties":{"preview":{"type":"string","enum":["short_drama_preview_v1"]},"final":{"type":"string","enum":["short_drama_final_v1"]}}}}},"current_preview_version":{"type":"integer","minimum":1,"nullable":true},"current_final_version":{"type":"integer","minimum":1,"nullable":true},"preview_locked":{"type":"boolean"},"implementation_status":{"type":"string","enum":["renderable"]},"rendering_enabled":{"type":"boolean","enum":[true]},"shots":{"type":"array","items":{"$ref":"#/components/schemas/ShortDramaAssemblyShot"}},"versions":{"type":"array","items":{"$ref":"#/components/schemas/ShortDramaCompositionVersion"}},"active_job":{"$ref":"#/components/schemas/ShortDramaCompositionJob"},"readiness":{"type":"object","required":["ready","blockers"],"additionalProperties":false,"properties":{"ready":{"type":"boolean"},"blockers":{"type":"array","items":{"$ref":"#/components/schemas/ShortDramaAssemblyBlocker"}}}},"actions":{"type":"object","required":["can_save_config","can_preview","can_lock_preview","can_export","can_confirm"],"additionalProperties":false,"properties":{"can_save_config":{"type":"boolean","enum":[false]},"can_preview":{"type":"boolean","enum":[false]},"can_lock_preview":{"type":"boolean","enum":[false]},"can_export":{"type":"boolean"},"can_confirm":{"type":"boolean"}}},"blockers":{"type":"array","items":{"$ref":"#/components/schemas/ShortDramaAssemblyBlocker"}}}},
      "ShortDramaCompositionJob": {"type":"object","nullable":true,"required":["job_id","kind","status","phase","progress","error_code","error_message","attempt_count","created_at","updated_at","finished_at"],"additionalProperties":false,"properties":{"job_id":{"type":"string"},"kind":{"type":"string","enum":["preview","final"]},"status":{"type":"string","enum":["queued","running","succeeded","failed"]},"phase":{"type":"string"},"progress":{"type":"integer","minimum":0,"maximum":100},"error_code":{"type":"string"},"error_message":{"type":"string"},"attempt_count":{"type":"integer","minimum":0},"created_at":{"type":"integer"},"updated_at":{"type":"integer"},"finished_at":{"type":"integer","nullable":true}}},
      "ShortDramaCompositionVersion": {"type":"object","required":["id","kind","version","job_id","input_hash","config","url","duration_ms","width","height","fps","video_codec","audio_codec","status","global_video_asset_id","created_at"],"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["preview","final"]},"version":{"type":"integer","minimum":1},"job_id":{"type":"string"},"input_hash":{"type":"string"},"config":{"type":"object"},"url":{"type":"string","format":"uri-reference"},"duration_ms":{"type":"integer","minimum":1,"nullable":true},"width":{"type":"integer","minimum":1,"nullable":true},"height":{"type":"integer","minimum":1,"nullable":true},"fps":{"type":"number","exclusiveMinimum":true,"minimum":0,"nullable":true},"video_codec":{"type":"string"},"audio_codec":{"type":"string"},"status":{"type":"string","enum":["rendering","succeeded","failed","stale"]},"global_video_asset_id":{"type":"integer","minimum":1,"nullable":true},"created_at":{"type":"integer"}}},
      "JobAccepted": {
        "type": "object",
        "description": "异步任务受理",
        "properties": {
          "job_id": {
            "type": "integer"
          },
          "cost": {
            "type": "integer",
            "description": "本次扣的点数"
          },
          "points_left": {
            "type": "integer"
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "error"
            ]
          },
          "result": {
            "type": "object",
            "description": "成功时结果(结构随 kind 不同)"
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "must_change": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/gen/short-drama/assembly": {"get":{"tags":["短剧"],"summary":"读取短剧成片合成工作区","description":"读取不扣点；当全部配音与视频版本已锁定后，可免费执行 FFmpeg 正式合成并推进 completed。本地项目仅创建者可读；共享项目需携带匹配的 X-Canvas-Board-Id，owner/editor/viewer 可读。","security":[{"bearerAuth":[]}],"parameters":[{"name":"X-Canvas-Board-Id","in":"header","required":false,"description":"Optional for a local short-drama project. Required for a shared short-drama project and must equal its board_id; owner/editor/viewer may read and owner/editor may write.","schema":{"type":"string","minLength":1,"maxLength":128}},{"name":"project_id","in":"query","required":true,"schema":{"type":"string","minLength":1}}],"responses":{"200":{"description":"短剧成片合成工作区快照","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShortDramaAssemblyWorkspace"}}}},"400":{"description":"缺少 project_id，或项目尚未进入 assembly_review/completed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"未登录","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"必须修改初始密码，或账号没有画布基础访问能力","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"项目不存在，或当前用户无权发现该项目","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
    "/api/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录(拿 token)",
        "security": [],
        "description": "账号密码登录。成功后返回 Bearer token，前端保存后用于调用需要登录的接口。\n\n安全策略：新签发 token 默认 30 天过期；登录失败会按 IP+账号做 5 分钟窗口限流，连续失败 5 次后暂时返回 429。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "fang"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求体不是合法 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "登录失败次数过多，请稍后再试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注册新账号",
        "security": [],
        "description": "用于前端登录页的“注册新账号”功能。提交账号、密码、可选昵称和可选邀请码后，后端会在同一事务中创建普通用户账号、保存直接邀请关系并签发登录会话。\n\n规则：username 必填，最长 64 位，不能包含空白字符；password 必填，至少 6 位；display_name 可选，不传时默认等于 username，最多 32 个字符；invite_code 始终可选。\n\n安全策略：注册接口按 IP 限流，默认 5 分钟最多 5 次尝试，成功或失败都会计数，超过返回 429。\n\n默认账户属性：points=16，role=member，must_change=false。\n\n网站注册成功后通过 HttpOnly Cookie 保持登录，不在响应体暴露 token。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 64,
                    "example": "test001"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "12345678"
                  },
                  "display_name": {
                    "type": "string",
                    "maxLength": 32,
                    "example": "测试用户"
                  },
                  "invite_code": {
                    "type": "string",
                    "maxLength": 32,
                    "description": "可选邀请码；不传或空值时正常注册但不绑定邀请关系"
                  },
                  "invite_source": {
                    "type": "string",
                    "enum": [
                      "web_link"
                    ],
                    "description": "从邀请链接进入时传 web_link；其他值按手动注册处理"
                  },
                  "device_id": {
                    "type": "string",
                    "maxLength": 256,
                    "description": "可选设备标识；服务端只保存 HMAC，不保存原值"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数不合法：账号/密码缺失、账号过长、账号含空白字符、昵称超过 32 字符或密码少于 6 位",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "账号已存在：username 与现有用户重复",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "注册次数过多，请稍后再试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/invite/code": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "获取当前用户的稳定邀请码",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "只返回邀请码和邀请链接，不返回下级账号、会员或财务信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "invite_link"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 6,
                      "maxLength": 6
                    },
                    "invite_link": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登出(撤销 token)",
        "description": "撤销当前 Bearer token。有效 token 首次登出返回 200；同一个 token 在本服务进程内重复登出仍返回 200，便于前端幂等处理；无 token、错误认证格式或从未存在的 token 返回 401。",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "未登录 / token 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/change_password": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "改密码(需当前密码，成功后旧 token 全部失效)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "old_password",
                  "new_password"
                ],
                "properties": {
                  "old_password": {
                    "type": "string",
                    "description": "当前密码"
                  },
                  "new_password": {
                    "type": "string",
                    "description": "至少 6 位"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK，当前用户所有已签发 token 失效，需要重新登录"
          },
          "400": {
            "description": "当前密码错误 / 新密码太短"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "当前用户信息 / 点数",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/api/gen/image": {
      "post": {
        "tags": [
          "作图"
        ],
        "summary": "gpt-image 作图(文生图/图生图/局部修改) · 12点",
        "description": "异步,返回 job_id。带 image 进图生图;再带 mask 进局部修改。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "openai",
                      "zelong"
                    ],
                    "default": "openai",
                    "description": "openai 失败时后端会自动 fallback 到 zelong"
                  },
                  "ratio": {
                    "type": "string",
                    "enum": [
                      "1:1",
                      "9:16",
                      "16:9",
                      "3:4"
                    ],
                    "default": "1:1",
                    "description": "3:4 对应 900x1200"
                  },
                  "image": {
                    "type": "string",
                    "description": "base64(无 data: 前缀),参考图→图生图"
                  },
                  "mask": {
                    "type": "string",
                    "description": "base64 蒙版→局部修改"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "402": {
            "description": "点数不足"
          }
        }
      }
    },
    "/api/gen/banana": {
      "post": {
        "tags": [
          "作图"
        ],
        "summary": "纳米香蕉作图（纳米香蕉 2 标准15点/高清25点；Pro 标准25点/高清30点）",
        "description": "异步返回 job_id。带 image 进图生图。提交前会校验 prompt/model/ratio/quality/count/image，参数错误直接 400，不扣点。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "model": {
                    "type": "string",
                    "enum": [
                      "nb2",
                      "pro"
                    ],
                    "default": "nb2",
                    "description": "nb2=纳米香蕉 2，pro=纳米香蕉 Pro"
                  },
                  "ratio": {
                    "type": "string",
                    "default": "1:1",
                    "description": "1:1 / 2:3 / 3:2 / 3:4 / 4:3 / 4:5 / 5:4 / 9:16 / 16:9 / 21:9"
                  },
                  "image": {
                    "type": "string",
                    "description": "base64 参考图，可带 data:image/...;base64, 前缀；传错会返回 400"
                  },
                  "quality": {
                    "type": "string",
                    "enum": [
                      "std",
                      "hd"
                    ],
                    "default": "std",
                    "description": "std=标准清晰度；hd=高清。默认 std；纳米香蕉 2 标准15点/高清25点，纳米香蕉 Pro 标准25点/高清30点"
                  },
                  "count": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ],
                    "default": 1,
                    "description": "生成张数，只支持 1 或 2；按张扣点"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
