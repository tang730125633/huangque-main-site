              "prompt": { "type": "string", "description": "文案需求/选题" }, "ctype": { "type": "string", "default": "通用" },
              "format": { "type": "string", "not": { "enum": ["short_drama"] }, "description": "script 为普通分镜脚本；省略则为通用文案" },
