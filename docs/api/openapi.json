          { "$ref": "#/components/schemas/ShortDramaPlanningRequest" }
        ] } } } },
        "responses": {
          "200": { "description": "已受理；返回 job_id、此次实际扣除的 cost 和 points_left", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobAccepted" } } } },
