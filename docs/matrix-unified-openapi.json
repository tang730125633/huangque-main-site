{
  "openapi": "3.1.0",
  "info": {"title": "Huangque Unified Template Jobs", "version": "1.0.0-preview", "description": "Opt-in API. See matrix-unified-api.md for implemented capabilities and remaining Word-contract gaps."},
  "security": [{"UserBearer": [], "InternalToken": []}],
  "paths": {
    "/internal/matrix-template/templates": {
      "get": {"operationId": "listMatrixTemplates", "responses": {"200": {"description": "Complete template catalog, text controls and supported input contract"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/internal/matrix-template/jobs": {
      "post": {
        "operationId": "submitMatrixJob",
        "description": "Creates a paid operation using the existing main-site ledger. Reuse dedupe_key after uncertain responses.",
        "parameters": [{"name": "Idempotency-Key", "in": "header", "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Request"}}}},
        "responses": {
          "202": {"description": "Durably accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Accepted"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "402": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/internal/matrix-template/jobs/{job_id}": {
      "get": {
        "operationId": "getMatrixJob",
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}],
        "responses": {"200": {"description": "Owner-scoped job with renewed private links", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"UserBearer": {"type": "http", "scheme": "bearer"}, "InternalToken": {"type": "apiKey", "in": "header", "name": "X-HQ-Internal-Token"}},
    "responses": {"Error": {"description": "Structured error. An uncertain response is not proof no job exists.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Request": {
        "type": "object", "additionalProperties": false, "required": ["template_id", "account", "texts"],
        "properties": {
          "template_id": {"type": "string", "pattern": "^[a-z0-9-]{1,100}$"},
          "account": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"account_id": {"type": "string"}, "username": {"type": "string"}}},
          "materials": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "auto"}}},
            {"type": "object", "additionalProperties": false, "required": ["mode", "ids"], "properties": {"mode": {"const": "picked"}, "ids": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "pattern": "^(?:(?:vid|img)_)?[0-9a-f]{32}$"}}}}
          ]},
          "texts": {"type": "object", "additionalProperties": false, "required": ["top_text", "bottom_text"], "properties": {"top_text": {"type": "string", "minLength": 2, "maxLength": 4000}, "bottom_text": {"type": "string", "minLength": 2, "maxLength": 4000}}},
          "voiceover": {"type": "object", "additionalProperties": false, "required": ["text", "voice"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 120}, "voice": {"type": "string", "minLength": 1}, "speed": {"type": "number", "minimum": 0.5, "maximum": 2}, "voice_scope": {"type": "string"}}},
          "bgm": {"type": "boolean"}, "bgm_volume": {"type": "number", "minimum": 0, "maximum": 1},
          "dedupe_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
          "text_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text_overrides": {"type": "object", "description": "Layer names and allowed fonts are supplied by templates[].text_controls.", "additionalProperties": {"$ref": "#/components/schemas/TextStyle"}}
        }
      },
      "TextStyle": {"type": "object", "additionalProperties": false, "properties": {
        "font_family": {"type": "string"}, "font_size_px": {"type": "integer", "minimum": 16, "maximum": 240},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "stroke_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "offset_x_px": {"type": "number", "minimum": -60, "maximum": 60}, "offset_y_px": {"type": "number", "minimum": -60, "maximum": 60},
        "stroke_width_px": {"type": "number", "minimum": 0, "maximum": 24}
      }},
      "Accepted": {"type": "object", "required": ["job_id", "status", "dedupe", "dedupe_key", "query_url"], "properties": {
        "job_id": {"type": "integer"}, "status": {"const": "accepted"}, "dedupe": {"type": "boolean"}, "dedupe_key": {"type": "string"}, "query_url": {"type": "string"}
      }},
      "Job": {"type": "object", "required": ["job_id", "status", "result", "materials_used", "error"], "properties": {
        "job_id": {"type": "integer"}, "status": {"enum": ["accepted", "preparing", "rendering", "ready", "failed", "canceled"]},
        "result": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["video_url", "cover_url", "duration_seconds", "width", "height", "file_size", "cos_key", "cover_cos_key", "url_expires_at"]}]},
        "materials_used": {"type": "array", "items": {"type": "object"}}, "error": {"oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/Error"}]}
      }},
      "Error": {"type": "object", "required": ["error", "http_status", "message", "details"], "properties": {
        "error": {"type": "string"}, "http_status": {"type": "integer"}, "message": {"type": "string"},
        "details": {"type": "object", "required": ["request_id", "stage", "job_created", "retryable"], "properties": {"request_id": {"type": "string"}, "stage": {"type": "string"}, "job_created": {"type": ["boolean", "null"]}, "job_id": {"type": ["integer", "null"]}, "retryable": {"type": "boolean"}, "retry_after": {"type": "integer"}}}
      }}
    }
  }
}
